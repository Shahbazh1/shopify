<style>
body {
  background: #1a1a1a;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto;
}

/* Header */
.orders-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

/* LEFT SIDE */
.orders-header .left {
  display: flex;
  align-items: center;
  gap: 8px;
}

/* ICON */
.icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 18px;
  height: 18px;
  color: #000;
}

.icon svg {
  width: 18px;
  height: 18px;
  fill: currentColor;
}

/* TITLE */
.orders-header h2 {
  font-size: 20px;
  font-weight: 600;
  color: #000;
}

/* CARD */
.orders-card {
  background: white;
  border-radius: 14px;
  border: 1px solid #e1e3e5;
  height: 500px;

  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  text-align: center;
}

/* TEXT */
.orders-card h3 {
  font-size: 18px;
  font-weight: 600;
  margin-bottom: 10px;
}

.orders-card p {
  max-width: 420px;
  font-size: 14px;
  color: #555;
  margin-bottom: 20px;
}

/* BUTTON */
.primary-btn {
  background: #1c1c1c;
  color: white;
  border: none;
  padding: 10px 18px;
  border-radius: 8px;
  cursor: pointer;
}
</style>

<div class="orders-page">

  <!-- HEADER -->
  <div class="orders-header">

    <div class="left">

      <!-- YOUR SVG ICON -->
      <span aria-hidden="true" class="icon color-base tone-brand size-base">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16">
          <path fill-rule="evenodd"
            d="M4.976 1.5a2.75 2.75 0 0 0-2.72 2.347l-.662 4.46a9 9 0 0 0-.094 1.282v1.661a3.25 3.25 0 0 0 3.25 3.25h6.5a3.25 3.25 0 0 0 3.25-3.25v-1.66q0-.645-.095-1.283l-.66-4.46a2.75 2.75 0 0 0-2.72-2.347h-6.05Zm-1.237 2.567a1.25 1.25 0 0 1 1.237-1.067h6.048c.62 0 1.146.454 1.237 1.067l.583 3.933h-2.484c-.538 0-1.015.344-1.185.855l-.159.474a.25.25 0 0 1-.237.171h-1.558a.25.25 0 0 1-.237-.17l-.159-.475a1.25 1.25 0 0 0-1.185-.855h-2.484zm-.738 5.433-.001.09v1.66c0 .966.784 1.75 1.75 1.75h6.5a1.75 1.75 0 0 0 1.75-1.75v-1.75h-2.46l-.1.303a1.75 1.75 0 0 1-1.66 1.197h-1.56a1.75 1.75 0 0 1-1.66-1.197l-.1-.303h-2.46Z">
          </path>
        </svg>
      </span>

      <h2>Drafts</h2>

    </div>

  </div>
  <!-- CARD -->
  <div class="orders-card">

    <div class="circle">
      <img src="https://cdn.shopify.com/shopifycloud/web/assets/v1/vite/client/en/assets/empty-state-orders-e08317223bd1.svg" />
    </div>

    <h3>Create draft orders and invoices</h3>

    <p>
      Use draft orders to take orders over the phone, email invoices to customers, and collect payments.
    </p>

<%= link_to "Create draft order", new_draft_order_path(@store), class: "primary-btn" %>
  </div>

</div>