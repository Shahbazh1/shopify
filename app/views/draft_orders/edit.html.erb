<style>
  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

.modal-overlay{
  position:fixed;
  top:0; left:0;
  width:100%; height:100%;
  background:rgba(0,0,0,0.5);
  display:flex;
  justify-content:center;
  align-items:center;
  z-index:999;
}

.modal-box{
  width:600px;
  background:white;
  border-radius:12px;
  overflow:hidden;
}

.modal-header{
  display:flex;
  justify-content:space-between;
  padding:12px 16px;
  border-bottom:1px solid #ddd;
}

.modal-body{
  max-height:400px;
  overflow:auto;
  padding:12px;
}

.modal-product{
  padding:10px;
}

  :root {
    --bg: #f1f1f1;
    --surface: #ffffff;
    --border: #dcdcdc;
    --text: #1a1a1a;
    --text-muted: #616161;
    --radius-lg: 12px;
    --shadow-sm: 0 1px 3px rgba(0,0,0,0.05);
  }

  body {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    background: var(--bg);
    color: var(--text);
    font-size: 13px;
    padding-bottom: 50px;
  }

  /* HEADER ACTIONS */
  .header-container {
    max-width: 1100px;
    margin: 20px auto 10px;
    padding: 0 20px;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }

  .order-title h1 { font-size: 20px; display: flex; align-items: center; gap: 8px; }
  .updated-by { color: var(--text-muted); font-size: 12px; margin-top: 4px; }

  .header-btns { display: flex; gap: 8px; }
  .btn-secondary {
    background: #ebebeb;
    border: 1px solid transparent;
    padding: 6px 12px;
    border-radius: 8px;
    font-weight: 500;
    cursor: pointer;
  }

  /* LAYOUT */
  .page-layout {
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: 16px;
    max-width: 1100px;
    margin: auto;
    padding: 0 20px;
  }

  .card {
    background: white;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-sm);
    margin-bottom: 16px;
  }

  .card-header {
    padding: 12px 16px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-weight: 600;
  }

  .card-body { padding: 0 16px 16px; }

  /* PRODUCTS SECTION */
  .product-row {
    display: flex;
    align-items: center;
    padding: 12px;
    border: 1px solid var(--border);
    border-radius: 10px;
    gap: 12px;
    margin-bottom: 8px;
  }
  .prod-img { width: 40px; height: 40px; background: #f5f5f5; border-radius: 6px; }
  .prod-info { flex: 1; }
  .prod-price-qty { display: flex; align-items: center; gap: 10px; }
  .qty-input { width: 60px; padding: 6px; border: 1px solid var(--border); border-radius: 6px; text-align: center; }

  /* PAYMENT TABLE */
  .payment-table { width: 100%; border-collapse: collapse; margin-top: 10px; }
  .payment-table td { padding: 8px 0; color: var(--text-muted); }
  .payment-table .val { text-align: right; color: var(--text); }
  .payment-table .link { color: #005bd3; cursor: pointer; text-decoration: none; }
  .total-row { border-top: 1px solid #eee; font-weight: 700; font-size: 14px; }
  .total-row td { padding-top: 12px; color: var(--text) !important; }

  .payment-footer {
    border-top: 1px solid #eee;
    padding: 16px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  /* INPUTS */
  input, select, textarea {
    width: 100%;
    padding: 8px 12px;
    border: 1px solid var(--border);
    border-radius: 8px;
    font-size: 13px;
  }

  .market-badge {
    background: #f1f1f1;
    padding: 4px 8px;
    border-radius: 6px;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    margin-bottom: 10px;
  }

  .btn-black {
    background: #303030;
    color: white;
    border: none;
    padding: 8px 16px;
    border-radius: 8px;
    font-weight: 600;
    cursor: pointer;
  }

  @media(max-width: 900px){ .page-layout { grid-template-columns: 1fr; } }
</style>

<div class="header-container">
  <div class="order-title">
    <h1><span style="color:#6b6b6b;">←</span> #D4</h1>
    <div class="updated-by">Updated by Shahbaz Hashmi today at 11:49 am</div>
  </div>
  <div class="header-btns">
    <button class="btn-secondary">Duplicate</button>
    <button class="btn-secondary">Share</button>
    <button class="btn-secondary">More actions ▾</button>
  </div>
</div>

<%= form_with model: @draft_order,
          url: draft_order_path(@store, @draft_order),
          method: :patch do |f| %>
                <%= f.hidden_field :status, id: "draft-order-status" %>

<%= f.hidden_field :subtotal, id: "draft-order-subtotal" %>

<%= f.hidden_field :discount_amount,
                   value: 0,
                   id: "draft-order-discount" %>

<%= f.hidden_field :shipping_price,
                   value: 250,
                   id: "draft-order-shipping" %>

<%= f.hidden_field :total_price,
                   id: "draft-order-total" %>
  <div class="page-layout">
    
    <!-- LEFT COLUMN -->
    <div>
      <!-- PRODUCTS -->
      <div class="card">
        <div class="card-header">
          <span>Products</span>
          <div style="display:flex; gap:8px;">
<button type="button" class="btn-secondary" style="background:white; border:1px solid #ddd;" onclick="openProductModal()">
  + Add product
</button>            <button type="button" class="btn-secondary" style="background:white; border:1px solid #ddd;">+ Add custom item</button>
          </div>
        </div>
        <!-- Replace the static product-row with this -->
<div class="card-body" id="selected-products-container">
<div class="card-body" id="selected-products-container">

  <% if @draft_order.draft_order_items.any? %>

    <% @draft_order.draft_order_items.each_with_index do |item, index| %>

      <div class="product-row"
           id="variant-<%= item.product_variant_id %>"
           data-price="<%= item.price %>">

        <div class="prod-img"></div>

        <div class="prod-info">
          <strong><%= item.product&.title %></strong>

          <div style="color:#6b6b6b; margin-top:4px;">
            <%= item.product_variant&.size %> /
            <%= item.product_variant&.color %>
          </div>
        </div>

        <div class="prod-price-qty">

          <div>
            Rs <span class="unit-price"><%= item.price %></span>
          </div>

          <input type="number"
                 value="<%= item.quantity %>"
                 min="1"
                 class="qty-input"
                 onchange="quantityChanged(this)">

          <div>
            Rs <span class="row-total">
              <%= item.price * item.quantity %>
            </span>
          </div>

          <button type="button"
                  onclick="removeRow(<%= item.product_variant_id %>)"
                  style="border:none;background:none;color:red;">
            ✕
          </button>
        </div>

        <!-- hidden fields -->
        <input type="hidden"
               name="draft_order[draft_order_items_attributes][<%= index %>][id]"
               value="<%= item.id %>">

        <input type="hidden"
               name="draft_order[draft_order_items_attributes][<%= index %>][product_id]"
               value="<%= item.product_id %>">

        <input type="hidden"
               name="draft_order[draft_order_items_attributes][<%= index %>][product_variant_id]"
               value="<%= item.product_variant_id %>">

        <input type="hidden"
               name="draft_order[draft_order_items_attributes][<%= index %>][price]"
               value="<%= item.price %>">

        <input type="hidden"
               name="draft_order[draft_order_items_attributes][<%= index %>][quantity]"
               value="<%= item.quantity %>"
               class="quantity-hidden">

      </div>

    <% end %>

  <% else %>

    <p id="no-products-msg" style="color:#6b6b6b; padding:10px;">
      No products selected.
    </p>

  <% end %>

</div></div>
      </div>

      <!-- PAYMENT -->
      <div class="card">
        <div class="card-header">Payment</div>
        <div class="card-body">
          <table class="payment-table">
  <tr>
    <td>Subtotal</td>
    <td id="total-items">0 items</td>
    <td class="val" id="subtotal-price">Rs 0.00</td>
  </tr>

  <tr>
    <td class="link">Add discount</td>
    <td>—</td>
    <td class="val">Rs 0.00</td>
  </tr>

  <tr>
    <td class="link">Add shipping or delivery</td>
    <td>—</td>
    <td class="val">Rs 0.00</td>
  </tr>

  <tr>
    <td class="link">
      Estimated tax
      <span style="font-size:10px; opacity:0.5;">ⓘ</span>
    </td>

    <td>16% GST</td>

    <td class="val" id="tax-price">Rs 0.00</td>
  </tr>

  <tr class="total-row">
    <td colspan="2">Total</td>
    <td class="val" id="grand-total">Rs 0.00</td>
  </tr>
</table>
        </div>
        <div class="payment-footer">
          <label style="display:flex; align-items:center; gap:8px;">
            <input type="checkbox" style="width:auto;"> Payment due later
          </label>
          <div style="display:flex; gap:8px;">

  <button type="submit"
          class="btn-secondary"
          onclick="setDraftStatus('cancelled')">
    Cancel Order
  </button>

  <button type="submit"
          class="btn-secondary"
          onclick="setDraftStatus('open')">
    Save
  </button>

  <button type="submit"
          class="btn-black"
          onclick="setDraftStatus('completed')">
    Mark as paid
  </button>

</div>
        </div>
      </div>
    </div>

    <!-- RIGHT COLUMN -->
    <div>
      <div class="card">
        <div class="card-header">Notes <span style="font-weight:normal; font-size:16px;">✎</span></div>
        <div class="card-body">
          <%= f.text_area :notes, placeholder: "No notes", style: "border:none; padding:0; resize:none;" %>
        </div>
      </div>

      <div class="card">
        <div class="card-header">Customer</div>
        <div class="card-body">
          <div style="position:relative;">
            <span style="position:absolute; left:10px; top:10px; color:#999;">🔍</span>
            <%= f.text_field :customer_name, placeholder: "Search or create a customer", style: "padding-left:30px;" %>
          </div>
        </div>
      </div>

      <div class="card">
        <div class="card-header">Markets <span style="font-weight:normal; font-size:16px;">🌐</span></div>
        <div class="card-body">
          <div class="market-badge">
            <span style="font-size:12px;">🌍</span> Pakistan
          </div>
          <div style="margin-top:10px;">
            <label style="color:var(--text-muted); display:block; margin-bottom:4px;">Currency</label>
            <select>
              <option>Pakistani Rupee (PKR Rs)</option>
            </select>
          </div>
        </div>
      </div>

      <div class="card">
        <div class="card-header">Tags <span style="font-weight:normal; font-size:16px;">✎</span></div>
        <div class="card-body">
          <%= f.text_field :tags, placeholder: "" %>
        </div>
      </div>
    </div>
  </div>
<% end %>

<div id="productModal" class="modal-overlay" style="display:none;">
  <div class="modal-box">
    
    <div class="modal-header">
      <h3>Select Product</h3>
      <span onclick="closeProductModal()" style="cursor:pointer;">✕</span>
    </div>

    <div class="modal-body">

      <% @products.each do |product| %>
        <div class="modal-product">
          <div>
            <strong><%= product.title %></strong>
          </div>

          <div style="margin-left:10px; margin-top:6px;">
  <% product.product_variants.each do |variant| %>
    <div style="display:flex; justify-content:space-between; padding:6px 0;">
      
      <span>
        <%= "#{variant.size} / #{variant.color}" %> — Rs <%= variant.price %>
      </span>

      <button type="button"
onclick="selectProduct(
  <%= product.id %>,
  <%= variant.id %>,
  '<%= j product.title %>',
  '<%= j variant.size %>',
  '<%= j variant.color %>',
  <%= variant.price %>
)">
  Add
</button>

    </div>
  <% end %>
</div>

        </div>
        <hr>
      <% end %>

    </div>
  </div>
</div>

<script>

function openProductModal(){
  document.getElementById("productModal").style.display = "flex";
}

function closeProductModal(){
  document.getElementById("productModal").style.display = "none";
}

function selectProduct(productId, variantId, title, size, color, price){

  const container = document.getElementById("selected-products-container");
  const noProductsMsg = document.getElementById("no-products-msg");

  if(noProductsMsg){
    noProductsMsg.remove();
  }

  // check if variant already exists
  let existingRow = document.getElementById(`variant-${variantId}`);

  if(existingRow){

    let qtyInput = existingRow.querySelector(".qty-input");

    qtyInput.value = parseInt(qtyInput.value) + 1;

rowQty = qtyInput.value;

existingRow.querySelector(".quantity-hidden").value = rowQty;

    updateRowTotal(existingRow, price);

    calculateTotals();

    closeProductModal();

    return;
  }

  // create row
  let row = document.createElement("div");

  row.className = "product-row";

  row.id = `variant-${variantId}`;

  row.setAttribute("data-price", price);

let index = Math.random().toString(36).substr(2, 9);

row.innerHTML = `
  
  <div class="prod-img"></div>

  <div class="prod-info">
    <strong>${title}</strong>

    <div style="color:#6b6b6b; margin-top:4px;">
      ${size} / ${color}
    </div>
  </div>

  <div class="prod-price-qty">

    <div>
      Rs <span class="unit-price">${price}</span>
    </div>

    <input type="number"
           value="1"
           min="1"
           class="qty-input"
           onchange="quantityChanged(this)"
    >

    <div>
      Rs <span class="row-total">${price}</span>
    </div>

    <button type="button"
            onclick="removeRow(${variantId})"
            style="
              border:none;
              background:none;
              cursor:pointer;
              color:red;
              font-size:18px;
            ">
      ✕
    </button>

  </div>

  <!-- HIDDEN FIELDS -->

  <input type="hidden"
         name="draft_order[draft_order_items_attributes][${index}][product_id]"
         value="${productId}"
         class="product-id">

  <input type="hidden"
         name="draft_order[draft_order_items_attributes][${index}][product_variant_id]"
         value="${variantId}"
         class="variant-id">

  <input type="hidden"
         name="draft_order[draft_order_items_attributes][${index}][price]"
         value="${price}"
         class="price-input">

  <input type="hidden"
         name="draft_order[draft_order_items_attributes][${index}][quantity]"
         value="1"
         class="quantity-hidden">
`;

  container.appendChild(row);

  calculateTotals();

  closeProductModal();
}

function quantityChanged(input){

  let row = input.closest(".product-row");

  let price = parseFloat(row.getAttribute("data-price"));

  let qty = parseInt(input.value);

  // update hidden quantity field
  row.querySelector(".quantity-hidden").value = qty;

  updateRowTotal(row, price);

  calculateTotals();
}

function updateRowTotal(row, price){

  let qty = parseInt(row.querySelector(".qty-input").value);

  let total = qty * price;

  row.querySelector(".row-total").innerText = total.toFixed(2);
}

function removeRow(variantId){

  let row = document.getElementById(`variant-${variantId}`);

  row.remove();

  let container = document.getElementById("selected-products-container");

  if(container.children.length === 0){

    container.innerHTML = `
      <p id="no-products-msg"
         style="color:#6b6b6b; padding:10px;">
        No products selected.
      </p>
    `;
  }

  calculateTotals();
}

function calculateTotals(){

  let rows = document.querySelectorAll(".product-row");

  let subtotal = 0;

  let totalItems = 0;

  rows.forEach(row => {

    let price = parseFloat(row.getAttribute("data-price"));

    let qty = parseInt(row.querySelector(".qty-input").value);

    subtotal += price * qty;

    totalItems += qty;
  });

  // static values
  let shipping = 250;

  let discount = 0;

  let tax = subtotal * 0.16;

  let grandTotal = subtotal + shipping + tax - discount;

  // UI update
  document.getElementById("subtotal-price").innerText =
    `Rs ${subtotal.toFixed(2)}`;

  document.getElementById("tax-price").innerText =
    `Rs ${tax.toFixed(2)}`;

  document.getElementById("grand-total").innerText =
    `Rs ${grandTotal.toFixed(2)}`;

  document.getElementById("total-items").innerText =
    `${totalItems} item${totalItems !== 1 ? 's' : ''}`;

  // hidden fields update
  document.getElementById("draft-order-subtotal").value =
    subtotal.toFixed(2);

  document.getElementById("draft-order-discount").value =
    discount.toFixed(2);

  document.getElementById("draft-order-shipping").value =
    shipping.toFixed(2);

  document.getElementById("draft-order-total").value =
    grandTotal.toFixed(2);
}

function setDraftStatus(status){

  document.getElementById("draft-order-status").value = status;
}

document.addEventListener("DOMContentLoaded", function () {
  calculateTotals();
});

</script>