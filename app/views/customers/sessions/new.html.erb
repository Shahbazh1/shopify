  <!-- Card -->
  <div class="card">
    <h2>Log in</h2>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>

      <div class="field">
        <%= f.label :email %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "example@email.com" %>
      </div>

      <div class="field">
        <%= f.label :password %>
        <%= f.password_field :password, autocomplete: "current-password" %>
      </div>

      <% if devise_mapping.rememberable? %>
        <div class="field remember-field">
          <%= f.check_box :remember_me %>
          <%= f.label :remember_me %>
        </div>
      <% end %>

      <div class="actions">
        <%= f.submit "Log in" %>
      </div>

    <% end %>

    <hr class="divider" />

    <div class="devise-links">
      <%= render "customers/shared/links" %>
    </div>
  </div>

  <p class="footer-note">
    By logging in, you agree to our
    <a href="#">Privacy Policy</a> and <a href="#">Terms of Service</a>.
  </p>

<style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      background-color: #0f0f10;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 24px 16px;
      color: #e8e8ea;
      -webkit-font-smoothing: antialiased;
    }

    /* ── Shopify logo ── */
    .shopify-logo {
      display: flex;
      justify-content: center;
      margin-bottom: 24px;
    }
    .shopify-logo svg { width: 108px; height: auto; }

    /* ── Card ── */
    .card {
      background: #1a1b1e;
      border-radius: 12px;
      box-shadow: 0 0 0 1px rgba(255,255,255,.07), 0 4px 24px rgba(0,0,0,.5);
      padding: 32px;
      width: 100%;
      max-width: 380px;
    }

    .card h2 {
      font-size: 20px;
      font-weight: 600;
      color: #f0f0f2;
      margin-bottom: 24px;
      text-align: center;
      letter-spacing: -0.2px;
    }

    /* ── Form fields ── */
    .field {
      margin-bottom: 16px;
    }

    .field label {
      display: block;
      font-size: 13px;
      font-weight: 500;
      color: #c9cace;
      margin-bottom: 6px;
    }

    .field input[type="email"],
    .field input[type="password"],
    .field input[type="text"] {
      display: block;
      width: 100%;
      height: 38px;
      padding: 0 12px;
      font-size: 14px;
      font-family: inherit;
      color: #e8e8ea;
      background: #111214;
      border: 1px solid #2e3035;
      border-radius: 6px;
      outline: none;
      transition: border-color 0.15s, box-shadow 0.15s;
      -webkit-appearance: none;
    }
    .field input::placeholder { color: #4b5057; }
    .field input:hover { border-color: #3e4148; }
    .field input:focus {
      border-color: #5a5f6b;
      box-shadow: 0 0 0 3px rgba(148,163,184,.1);
    }

    /* ── Remember me ── */
    .field.remember-field {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 16px;
    }
    .field.remember-field input[type="checkbox"] {
      width: 16px;
      height: 16px;
      min-width: 16px;
      accent-color: #e8e8ea;
      background: #111214;
      border: 1px solid #2e3035;
      border-radius: 3px;
      cursor: pointer;
      margin: 0;
    }
    .field.remember-field label {
      font-size: 13px;
      font-weight: 400;
      color: #94a3b8;
      margin-bottom: 0;
      cursor: pointer;
    }

    /* ── Submit button ── */
    .actions {
      margin-top: 20px;
    }
    .actions input[type="submit"] {
      display: block;
      width: 100%;
      height: 38px;
      background: #e8e8ea;
      color: #0f0f10;
      font-size: 14px;
      font-weight: 600;
      font-family: inherit;
      border: none;
      border-radius: 6px;
      cursor: pointer;
      transition: background 0.15s, box-shadow 0.15s;
      -webkit-appearance: none;
      letter-spacing: 0.1px;
    }
    .actions input[type="submit"]:hover { background: #ffffff; }
    .actions input[type="submit"]:active { background: #cbd5e1; }
    .actions input[type="submit"]:focus {
      outline: none;
      box-shadow: 0 0 0 3px rgba(232,232,234,.2);
    }

    /* ── Shared links ── */
    .devise-links {
      margin-top: 20px;
      text-align: center;
      font-size: 13px;
      color: #6b7280;
    }
    .devise-links a {
      color: #94a3b8;
      text-decoration: none;
      font-weight: 500;
    }
    .devise-links a:hover {
      color: #e8e8ea;
      text-decoration: underline;
    }
    .devise-links p { margin-bottom: 6px; }

    /* ── Divider ── */
    .divider {
      border: none;
      border-top: 1px solid #22252b;
      margin: 20px 0;
    }

    /* ── Footer ── */
    .footer-note {
      margin-top: 20px;
      font-size: 12px;
      color: #4b5057;
      text-align: center;
      line-height: 1.5;
    }
    .footer-note a { color: #6b7280; text-decoration: none; }
    .footer-note a:hover { color: #94a3b8; text-decoration: underline; }
  </style>