<%# app/views/customers/show.html.erb %>

<style>
  body {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial;
    background: #f1f2f4;
    margin: 0;
    color: #202223;
  }

  .container {
    padding: 20px;
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 16px;
    max-width: 1200px;
    margin: auto;
  }

  /* HEADER */
  .header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 18px 20px;
  }

  .title {
    font-size: 20px;
    font-weight: 600;
  }

  .btn {
    padding: 8px 12px;
    border: 1px solid #c9cccf;
    background: white;
    border-radius: 6px;
    font-size: 13px;
    text-decoration: none;
    color: #202223;
  }

  .btn-danger {
    border-color: #d72c0d;
    color: #d72c0d;
  }

  /* CARD */
  .card {
    background: #fff;
    border: 1px solid #e1e3e5;
    border-radius: 10px;
    padding: 16px;
    margin-bottom: 16px;
  }

  .card h3 {
    font-size: 14px;
    margin-bottom: 12px;
  }

  /* STATS */
  .stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    background: #fff;
    border: 1px solid #e1e3e5;
    border-radius: 10px;
    overflow: hidden;
  }

  .stat {
    padding: 14px;
    text-align: center;
    border-right: 1px solid #eee;
  }

  .stat:last-child { border-right: none; }

  .stat .value {
    font-size: 16px;
    font-weight: 600;
  }

  .stat .label {
    font-size: 12px;
    color: #6d7175;
  }

  /* CUSTOMER HEADER */
  .customer-top {
    display: flex;
    align-items: center;
    gap: 12px;
    padding-bottom: 14px;
    border-bottom: 1px solid #eee;
    margin-bottom: 14px;
  }

  .avatar {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: #ddd;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 600;
  }

  .name {
    font-weight: 600;
  }

  .email {
    font-size: 13px;
    color: #6d7175;
  }

  .row {
    display: flex;
    justify-content: space-between;
    padding: 6px 0;
    font-size: 13px;
  }

  .label { color: #6d7175; }

  /* SIDEBAR */
  .side-card h4 {
    font-size: 13px;
    margin-bottom: 10px;
  }

  .small {
    font-size: 13px;
    color: #6d7175;
    line-height: 1.6;
  }

  .tag {
    display: inline-block;
    padding: 3px 8px;
    background: #eef0f2;
    border-radius: 4px;
    font-size: 12px;
  }

  .empty {
    color: #9aa0a6;
    font-style: italic;
  }
</style>

<!-- HEADER -->
<div class="header">
  <div class="title">
    <%= @customer.first_name %> <%= @customer.last_name %>
  </div>

  <div style="display:flex; gap:8px;">
    <%= link_to "Edit", edit_customer_path(@store, @customer), class: "btn" %>
    <%= link_to "Delete",
      customer_path(@store,@customer),
      data: { turbo_method: :delete, turbo_confirm: "Are you sure?" },
      class: "btn btn-danger"
    %>
  </div>
</div>

<div class="container">

  <!-- LEFT SIDE -->
  <div>

    <!-- STATS ROW (STATIC + PARTIAL DYNAMIC) -->
    <div class="stats">
      <div class="stat">
        <div class="value">Rs 0.00</div>
        <div class="label">Amount spent</div>
      </div>

      <div class="stat">
        <div class="value"><%= @customer.orders.count %></div>
        <div class="label">Orders</div>
      </div>

      <div class="stat">
        <div class="value"><%= @customer.created_at.strftime("%b %d") %></div>
        <div class="label">Customer since</div>
      </div>

      <div class="stat">
        <div class="value">—</div>
        <div class="label">RFM group</div>
      </div>
    </div>

    <!-- LAST ORDER -->
    <div class="card">
      <h3>Last order placed</h3>

      <% if @customer.orders.any? %>
        <p class="small">
          Last order: #<%= @customer.orders.last.id %>
        </p>
      <% else %>
        <p class="small empty">This customer hasn’t placed any orders yet</p>
        <button class="btn">Create order</button>
      <% end %>
    </div>

    <!-- TIMELINE -->
    <div class="card">
      <h3>Timeline</h3>
      <p class="small empty">No activity yet</p>
    </div>

  </div>

  <!-- RIGHT SIDE -->
  <div>

    <!-- CUSTOMER INFO -->
    <div class="card side-card">
      <h4>Customer</h4>

      <div class="small">
        <strong>Contact</strong><br>
        <%= @customer.email || "No email" %><br>
        <%= @customer.phone || "No phone" %>
      </div>

      <hr style="margin:10px 0;">

      <div class="small">
        <strong>Default address</strong><br>

        <% if @customer.address.present? %>
          <%= @customer.address %><br>
          <%= @customer.city %>, Pakistan
        <% else %>
          <span class="empty">No address</span>
        <% end %>
      </div>
    </div>

    <!-- MARKETING -->
    <div class="card side-card">
      <h4>Marketing</h4>
      <span class="tag">Email</span>
      <span class="tag">SMS</span>
    </div>

    <!-- TAX -->
    <div class="card side-card">
      <h4>Tax details</h4>
      <p class="small">Collect tax: Yes</p>
    </div>

    <!-- STORE CREDIT -->
    <div class="card side-card">
      <h4>Store credit</h4>
      <p class="small">None</p>
    </div>

    <!-- TAGS -->
    <div class="card side-card">
      <h4>Tags</h4>
      <span class="tag">—</span>
    </div>


  </div>

</div>