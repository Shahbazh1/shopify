
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      background: #f1f1f1;
      color: #1a1a1a;
      font-size: 14px;
      line-height: 1.5;
      min-height: 100vh;
    }

    /* ── Page wrapper ── */
    .page {
      max-width: 1440px;
      margin: 0 auto;
      padding: 20px 20px 40px;
    }

    /* ── Top bar ── */
    .topbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 16px;
    }

    .topbar-title {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 20px;
      font-weight: 600;
      color: #1a1a1a;
    }

    .topbar-title svg {
      width: 22px;
      height: 22px;
      color: #1a1a1a;
    }

    .topbar-actions {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    /* ── Buttons ── */
    .btn {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      height: 34px;
      padding: 0 14px;
      border-radius: 8px;
      font-size: 13.5px;
      font-weight: 500;
      cursor: pointer;
      border: 1px solid transparent;
      white-space: nowrap;
      transition: background 0.12s, border-color 0.12s, box-shadow 0.12s;
      text-decoration: none;
    }

    .btn-secondary {
      background: #fff;
      border-color: #d4d4d4;
      color: #1a1a1a;
      box-shadow: 0 1px 2px rgba(0,0,0,.07);
    }
    .btn-secondary:hover { background: #f6f6f6; }

    .btn-primary {
      background: #1a1a1a;
      border-color: #1a1a1a;
      color: #fff;
      box-shadow: 0 1px 2px rgba(0,0,0,.18);
    }
    .btn-primary:hover { background: #333; border-color: #333; }

    .btn-more {
      background: #fff;
      border-color: #d4d4d4;
      color: #1a1a1a;
      box-shadow: 0 1px 2px rgba(0,0,0,.07);
    }
    .btn-more:hover { background: #f6f6f6; }

    .btn-more svg {
      width: 14px;
      height: 14px;
    }

    /* ── Card ── */
    .card {
      background: #fff;
      border-radius: 12px;
      border: 1px solid #e3e3e3;
      box-shadow: 0 1px 3px rgba(0,0,0,.06);
      overflow: hidden;
    }

    /* ── Search bar ── */
    .search-row {
      display: flex;
      align-items: center;
      gap: 0;
      padding: 10px 14px;
      border-bottom: 1px solid #e8e8e8;
    }

    .tab-all {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      font-size: 13.5px;
      font-weight: 500;
      color: #1a1a1a;
      margin-right: 10px;
      cursor: pointer;
    }

    .tab-all svg {
      width: 14px;
      height: 14px;
      color: #6b6b6b;
    }

    .search-input-wrap {
      display: flex;
      align-items: center;
      gap: 6px;
      flex: 1;
    }

    .search-input-wrap svg {
      width: 16px;
      height: 16px;
      color: #8c8c8c;
      flex-shrink: 0;
    }

    .search-input {
      border: none;
      outline: none;
      font-size: 13.5px;
      color: #6b6b6b;
      background: transparent;
      width: 100%;
    }

    .col-toggle {
      margin-left: auto;
      cursor: pointer;
      color: #6b6b6b;
      display: flex;
      align-items: center;
    }
    .col-toggle svg { width: 18px; height: 18px; }

    /* ── Table ── */
    table {
      width: 100%;
      border-collapse: collapse;
    }

    thead tr {
      border-bottom: 1px solid #e8e8e8;
    }

    th {
      padding: 10px 14px;
      text-align: left;
      font-size: 12.5px;
      font-weight: 500;
      color: #6b6b6b;
    }

    th:first-child, td:first-child {
      width: 36px;
      padding-right: 0;
    }

    th.col-product { min-width: 220px; }

    td {
      padding: 14px 14px;
      font-size: 13.5px;
      color: #1a1a1a;
      vertical-align: middle;
      border-bottom: 1px solid #f0f0f0;
    }

    tbody tr:last-child td { border-bottom: none; }
    tbody tr:hover { background: #fafafa; }

    /* ── Checkbox ── */
    .cb {
      width: 16px;
      height: 16px;
      border: 1.5px solid #c9c9c9;
      border-radius: 4px;
      cursor: pointer;
      appearance: none;
      -webkit-appearance: none;
      background: #fff;
      display: block;
    }
    .cb:hover { border-color: #888; }

    /* ── Product cell ── */
    .product-cell {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .product-thumb {
      width: 38px;
      height: 38px;
      border-radius: 6px;
      border: 1px solid #e3e3e3;
      background: #f5f5f5;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      color: #b0b0b0;
    }
    .product-thumb svg { width: 18px; height: 18px; }

    .product-name {
      font-size: 13.5px;
      font-weight: 500;
      color: #1a1a1a;
    }

    /* ── Status badge ── */
    .badge {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 3px 10px;
      border-radius: 20px;
      font-size: 12.5px;
      font-weight: 500;
    }
    .badge-active {
      background: #d4f5d4;
      color: #1a6e1a;
    }
    .badge-active::before {
      content: '';
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: #2a9c2a;
      flex-shrink: 0;
    }

    /* ── Learn more ── */
    .learn-more {
      text-align: center;
      padding: 24px 0 10px;
      font-size: 13.5px;
    }
    .learn-more a {
      color: #1a1a1a;
      font-weight: 500;
      text-decoration: underline;
      text-underline-offset: 2px;
    }
  </style>

  <div class="page">

    <!-- Top bar -->
    <div class="topbar">
      <div class="topbar-title">
        <!-- Tag/label icon matching Shopify's Products icon -->
        <svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M11.293 1.293a1 1 0 0 1 1.414 0l6 6a1 1 0 0 1 0 1.414l-7 7a1 1 0 0 1-1.414 0l-6-6A1 1 0 0 1 4 9V3a1 1 0 0 1 1-1h6.293zM5.5 7a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3z" fill="currentColor"/>
        </svg>
        Products
      </div>

      <div class="topbar-actions">
        <button class="btn btn-secondary">Export</button>
        <button class="btn btn-secondary">Import</button>
        <button class="btn btn-more">
          More actions
          <svg viewBox="0 0 20 20" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
            <path d="M5.293 7.293a1 1 0 0 1 1.414 0L10 10.586l3.293-3.293a1 1 0 1 1 1.414 1.414l-4 4a1 1 0 0 1-1.414 0l-4-4a1 1 0 0 1 0-1.414z"/>
          </svg>
        </button>
        <%= link_to new_product_path, class: "btn btn-primary" do %>
  Add product
<% end %>
      </div>
    </div>

    <!-- Main card -->
    <div class="card">

      <!-- Search / filter row -->
      <div class="search-row">
        <span class="tab-all">
          All
          <svg viewBox="0 0 20 20" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
            <path d="M5 8l5 5 5-5H5z"/>
          </svg>
        </span>

        <div class="search-input-wrap">
          <!-- Magnifier -->
          <svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M8.5 3a5.5 5.5 0 1 0 3.476 9.69l3.667 3.667a.75.75 0 1 0 1.06-1.06l-3.666-3.667A5.5 5.5 0 0 0 8.5 3zm-4 5.5a4 4 0 1 1 8 0 4 4 0 0 1-8 0z" fill="currentColor"/>
          </svg>
          <input class="search-input" type="text" placeholder="Search and filter" />
        </div>

        <!-- Column toggle -->
        <div class="col-toggle">
          <svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect x="3" y="4" width="4" height="12" rx="1" stroke="currentColor" stroke-width="1.5"/>
            <rect x="8" y="4" width="4" height="12" rx="1" stroke="currentColor" stroke-width="1.5"/>
            <rect x="13" y="4" width="4" height="12" rx="1" stroke="currentColor" stroke-width="1.5"/>
          </svg>
        </div>
      </div>

      <!-- Table -->
      <table>
        <thead>
          <tr>
            <th><input type="checkbox" class="cb" /></th>
            <th class="col-product">Product</th>
            <th>Inventory</th>
            <th>Category</th>
            <th>Publish online status</th>
            <th>Product type</th>
            <th>Vendor</th>
          </tr>
        </thead>
        <tbody>
  <% products.each do |product| %>
    <tr class="clickable-row" data-href="<%= edit_product_path(@store, product) %>">
      <td><input type="checkbox" class="cb" /></td>

      <!-- Product -->
      <td>
        <div class="product-cell">
          <div class="product-thumb">
            <% if product.product_images.any? && product.product_images.first.image_url.present? %>
              <%= image_tag product.product_images.first.image_url, width: 38, height: 38, alt: product.title %>
            <% else %>
              <!-- Placeholder -->
              <svg viewBox="0 0 20 20" fill="none">
                <rect x="2" y="2" width="16" height="16" rx="2" stroke="currentColor" stroke-width="1.5"/>
                <circle cx="7" cy="7" r="1.5" stroke="currentColor" stroke-width="1.2"/>
                <path d="M2 13l4-4 3 3 2-2 5 5" stroke="currentColor" stroke-width="1.2"/>
              </svg>
            <% end %>
          </div>

          <span class="product-name">
            <%= product.title || "Untitled Product" %>
          </span>
        </div>
      </td>

      <!-- Inventory -->
      <td>
  <% if product.product_variants.any? %>
    <%= product.product_variants.sum(:stock_quantity) %> in stock for 
    <%= product.product_variants.count %> variant(s)
  <% else %>
    0 in stock
  <% end %>
</td>

      <!-- Category -->
      <td>
        <%= product.category || "Uncategorized" %>
      </td>

      <!-- Publish online status -->
      <td>
        <span class="badge badge-active">
          <%= product.published_online_store? ? "Published" : "Not published" %>
        </span>
      </td>

      <!-- Product Type (use category) -->
<td>
  <%= product.category || "-" %>
</td>

<!-- Vendor (use store name) -->
<td>
  <%= product.store&.name || "My Store" %>
</td>
    </tr>
  <% end %>
</tbody>
      </table>

      <!-- Learn more -->
      <div class="learn-more">
        <a href="#">Learn more about products</a>
      </div>

    </div><!-- /card -->
  </div><!-- /page -->

<script>
  document.addEventListener("DOMContentLoaded", function () {
    document.querySelectorAll(".clickable-row").forEach(function (row) {
      row.style.cursor = "pointer";

      row.addEventListener("click", function (e) {
        // prevent checkbox click from triggering navigation
        if (e.target.type !== "checkbox") {
          window.location = row.dataset.href;
        }
      });
    });
  });
</script>