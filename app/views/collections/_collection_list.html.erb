<style>
.collections-page {
  padding-top: 20px;
  background: #f1f1f1;
  min-height: 100vh;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
}

/* Header */
.page-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16px;
}

.title {
  display: flex;
  align-items: center;
  gap: 8px;
}

.title h2 {
  font-size: 20px;
  font-weight: 600;
  color: #202223;
  margin: 0;
}

/* Icon */
.icon-wrapper svg {
  width: 18px;
  height: 18px;
  fill: #202223;
}

/* Button */
.btn.primary {
  background: #1c1c1c;
  color: #fff;
  padding: 8px 16px;
  border-radius: 10px;
  text-decoration: none;
  font-size: 14px;
}

/* Card */
.card {
  background: #fff;
  border-radius: 12px;
  border: 1px solid #e1e3e5;
  overflow: hidden;
}

/* Toolbar */
.toolbar {
  display: flex;
  justify-content: space-between;
  padding: 12px 16px;
  border-bottom: 1px solid #e1e3e5;
}

.toolbar .left {
  display: flex;
  align-items: center;
  gap: 16px;
}

.filter {
  font-size: 14px;
  color: #202223;
  cursor: pointer;
}

.search {
  display: flex;
  align-items: center;
  background: #f1f2f3;
  padding: 6px 10px;
  border-radius: 8px;
}

.search input {
  border: none;
  outline: none;
  background: transparent;
  margin-left: 6px;
  font-size: 14px;
}

/* View icon */
.view-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
}

.view-icon svg {
  width: 18px;
  height: 18px;
  fill: #6d7175;
  transition: 0.2s ease;
}

.view-icon:hover svg {
  fill: #202223;
}

/* Table */
.table {
  width: 100%;
}

.table-row {
  display: grid;
  grid-template-columns: 40px 1fr 120px 200px;
  align-items: center;
  padding: 12px 16px;
  border-bottom: 1px solid #f1f2f3;
}

.table-row.header {
  background: #fafbfb;
  font-size: 13px;
  color: #6d7175;
  font-weight: 500;
}

/* Cells */
.title-cell {
  display: flex;
  align-items: center;
  gap: 12px;
}

.thumb {
  width: 40px;
  height: 40px;
  background: #f1f2f3;
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.name {
  font-size: 14px;
  color: #202223;
}

.sub {
  font-size: 13px;
  color: #6d7175;
}

.footer-link {
  text-align: center;
  margin-top: 20px;
}

.footer-link a {
  color: #2c6ecb;
  text-decoration: none;
  font-size: 14px;
}
.clickable-row{
  cursor:pointer;
  transition: background 0.2s ease;
}

.clickable-row:hover{
  background:#f9fafb;
}

</style>

<div class="collections-page">

  <!-- HEADER -->
  <div class="page-header">

    <div class="title">
      <span class="icon-wrapper">
        <!-- COLLECTION ICON -->
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16">
          <path d="M9.5 5.5a1 1 0 1 0 0-2 1 1 0 0 0 0 2"></path>
          <path fill-rule="evenodd" d="M5.517 2.098a3.75 3.75 0 0 1 2.652-1.098h2.081a2.75 2.75 0 0 1 2.75 2.75v2.289c0 .862-.342 1.688-.952 2.298l-4.206 4.206a2.5 2.5 0 0 1-3.536 0l-2.672-2.673a2.75 2.75 0 0 1 0-3.889zm2.652.402c-.597 0-1.17.237-1.591.659l-3.883 3.883a1.25 1.25 0 0 0 0 1.768l2.672 2.672a1 1 0 0 0 1.414 0l4.206-4.206c.329-.328.513-.773.513-1.237v-2.289c0-.69-.56-1.25-1.25-1.25z"></path>
          <path d="M14.75 3.5a.75.75 0 0 1 .75.75v3.029c0 .87-.348 1.703-.967 2.313l-4.756 4.692a.75.75 0 0 1-1.054-1.067l4.756-4.693c.333-.328.521-.777.521-1.245v-3.029a.75.75 0 0 1 .75-.75"></path>
        </svg>
      </span>

      <h2>Collections</h2>
    </div>

    <%= link_to "Add collection", new_collection_path(store_id: @store.id), class: "btn primary" %>

  </div>

  <!-- CARD -->
  <div class="card">

    <!-- TOOLBAR -->
    <div class="toolbar">
      <div class="left">
        <span class="filter">All ⌄</span>
        <div class="search">
          <span>🔍</span>
          <input type="text" placeholder="Search and filter">
        </div>
      </div>

      <div class="right view-icon">
        <!-- VIEW ICON -->
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16">
          <path fill-rule="evenodd" d="M4 1a3 3 0 0 0-3 3v8a3 3 0 0 0 3 3h8a3 3 0 0 0 3-3v-8a3 3 0 0 0-3-3zm5.25 1.5h-2.5v11h2.5zm1.5 0v11h1.25a1.5 1.5 0 0 0 1.5-1.5v-8a1.5 1.5 0 0 0-1.5-1.5zm-6.75 0h1.25v11h-1.25a1.5 1.5 0 0 1-1.5-1.5v-8a1.5 1.5 0 0 1 1.5-1.5"></path>
        </svg>
      </div>

    </div>

    <!-- TABLE -->
    <div class="table">

      <div class="table-row header">
        <div><input type="checkbox"></div>
        <div>Title</div>
        <div>Products</div>
        <div>Product conditions</div>
      </div>

      <% @collections.each do |collection| %>
  <div class="table-row clickable-row" data-href="<%= edit_collection_path(@store, collection) %>">
    
    <div>
      <input type="checkbox">
    </div>

    <div class="title-cell">
      <div class="thumb">🖼</div>

      <div>
        <div class="name"><%= collection.title %></div>
        <div class="sub"><%= collection.description %></div>
      </div>
    </div>

    <div>
      <%= collection.products.count %>
    </div>

    <div>
      <!-- you can show conditions later -->
    </div>

  </div>
<% end %>

    </div>

  </div>

  <div class="footer-link">
    <a href="#">Learn more about collections</a>
  </div>

</div>

<script>
document.querySelectorAll(".clickable-row").forEach(row => {

  row.addEventListener("click", function(e) {

    // prevent navigation when checkbox clicked
    if (e.target.tagName === "INPUT") return;

    window.location.href = this.dataset.href;
  });

});
</script>