<%= form_with model: @collection, url: collections_path(@store), local: true do |f| %><div class="page-wrapper">

  <!-- LEFT SIDE -->
  <div class="main-content">

    <!-- COLLECTION DETAILS -->
    <div class="card">
      <h2 class="section-title">
        <%= @collection.persisted? ? "Edit collection" : "Add collection" %>
      </h2>

      <div class="field">
        <label>Title</label>
        <%= f.text_field :title, placeholder: "e.g., Summer collection, Under $100, Staff picks" %>
      </div>

      <div class="field">
        <label>Description</label>
        <%= f.text_area :description, rows: 6, placeholder: "Write description..." %>
      </div>
    </div>

    <!-- PRODUCTS -->
    <div class="card">
      <div class="card-header">
        <h3>Products</h3>
        <button type="button" id="openModal" class="btn-outline">Browse</button>
      </div>

      <div id="selected-products" class="<%= @collection.products.any? ? '' : 'empty-state' %>">
        <% if @collection.products.any? %>
          <% @collection.products.each do |product| %>
            <div><%= product.title %></div>
          <% end %>
        <% else %>
          No products selected
        <% end %>
      </div>
    </div>

  </div>

  <!-- RIGHT SIDEBAR -->
  <div class="sidebar">

    <div class="card">
      <h3 class="card-title">Publishing</h3>
      <p class="muted">Sales channels</p>

      <label class="checkbox">
        <input type="checkbox" checked>
        Online Store
      </label>

      <label class="checkbox">
        <input type="checkbox">
        Point of Sale
      </label>
    </div>

    <div class="card">
      <h3 class="card-title">Image</h3>
      <div class="upload-box">
        <span>📷</span>
        <p>Add image or drop file to upload</p>
      </div>
    </div>

    <div class="card">
      <h3 class="card-title">Theme template</h3>
      <select>
        <option>Default collection</option>
      </select>
    </div>

  </div>
</div>

<!-- FOOTER -->
<div class="footer">
  <%= f.submit @collection.persisted? ? "Update collection" : "Save collection", class: "btn-primary" %>
</div>

<!-- HIDDEN INPUTS -->
<div id="hidden-products">

  <% @collection.product_collections.each_with_index do |pc, index| %>
    <input
      type="hidden"
      name="collection[product_collections_attributes][<%= index %>][product_id]"
      value="<%= pc.product_id %>">
  <% end %>

</div>

<!-- MODAL -->
<div id="productModal" class="modal hidden">
  <div class="modal-box">

    <div class="modal-header">
      <h3>Select Products</h3>
      <button type="button" id="closeModal">✖</button>
    </div>

    <div class="modal-body">
      <% selected_product_ids = @collection.products.pluck(:id) %>

      <% @products.each do |product| %>
        <label class="product-item">
          <input
            type="checkbox"
            class="product-checkbox"
            value="<%= product.id %>"
            <%= "checked" if selected_product_ids.include?(product.id) %>>
          <span><%= product.title %></span>
        </label>
      <% end %>
    </div>

    <div class="modal-footer">
      <button type="button" id="addProducts" class="btn-primary-sm">Add Selected</button>
    </div>

  </div>
</div>

<% end %>

<!-- ================= CSS ================= -->
<style>
body{
  background:#f1f3f5;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial;
  color:#111;
}

/* LAYOUT */
.page-wrapper{
  display:grid;
  grid-template-columns: 2fr 1fr;
  gap:24px;
  padding:24px;
}

/* CARD */
.card{
  background:#fff;
  border-radius:12px;
  padding:20px;
  margin-bottom:16px;
  border:1px solid #e5e7eb;
}

/* HEADINGS */
.section-title{
  font-size:20px;
  font-weight:600;
  margin-bottom:16px;
}

.card-title{
  font-size:15px;
  font-weight:600;
  margin-bottom:10px;
}

/* FIELDS */
.field{
  margin-bottom:14px;
}

.field label{
  font-size:13px;
  color:#374151;
  display:block;
  margin-bottom:6px;
}

.field input,
.field textarea,
select{
  width:100%;
  padding:10px 12px;
  border:1px solid #d1d5db;
  border-radius:8px;
  font-size:14px;
  outline:none;
}

.field input:focus,
.field textarea:focus,
select:focus{
  border-color:#008060;
  box-shadow:0 0 0 2px rgba(0,128,96,0.15);
}

/* HEADER ROW */
.card-header{
  display:flex;
  justify-content:space-between;
  align-items:center;
  margin-bottom:12px;
}

/* BUTTONS */
button{
  cursor:pointer;
}

.btn-outline{
  border:1px solid #d1d5db;
  background:#fff;
  padding:6px 12px;
  border-radius:8px;
}

.btn-primary{
  background:#008060;
  color:#fff;
  padding:10px 18px;
  border:none;
  border-radius:10px;
  font-weight:600;
}

.btn-primary-sm{
  background:#008060;
  color:#fff;
  padding:8px 12px;
  border:none;
  border-radius:8px;
}

/* EMPTY STATE */
.empty-state{
  color:#6b7280;
  font-size:14px;
  padding:12px 0;
}

/* CHECKBOX */
.checkbox{
  display:flex;
  gap:8px;
  align-items:center;
  margin:8px 0;
  font-size:14px;
}

/* UPLOAD */
.upload-box{
  border:1.5px dashed #cbd5e1;
  border-radius:10px;
  padding:24px;
  text-align:center;
  color:#6b7280;
}

/* FOOTER */
.footer{
  padding:16px 24px;
  background:#fff;
  border-top:1px solid #e5e7eb;
  display:flex;
  justify-content:flex-end;
}

/* MODAL */
.modal{
  position:fixed;
  inset:0;
  background:rgba(0,0,0,0.4);
  display:flex;
  align-items:center;
  justify-content:center;
}

.hidden{ display:none; }

.modal-box{
  width:520px;
  background:#fff;
  border-radius:12px;
  overflow:hidden;
}

.modal-header,
.modal-footer{
  padding:12px 16px;
  border-bottom:1px solid #eee;
  display:flex;
  justify-content:space-between;
  align-items:center;
}

.modal-body{
  padding:12px;
  max-height:300px;
  overflow:auto;
}

.product-item{
  display:flex;
  gap:10px;
  padding:10px;
  border-radius:8px;
}

.product-item:hover{
  background:#f9fafb;
}
</style>

<!-- ================= JS (UNCHANGED) ================= -->
<script>
const modal = document.getElementById("productModal");

document.getElementById("openModal").onclick = () => {
  modal.classList.remove("hidden");
};

document.getElementById("closeModal").onclick = () => {
  modal.classList.add("hidden");
};

document.getElementById("addProducts").onclick = () => {

  const selected = document.querySelectorAll(".product-checkbox:checked");

  const hiddenContainer = document.getElementById("hidden-products");
  const display = document.getElementById("selected-products");

  hiddenContainer.innerHTML = "";
  display.innerHTML = "";

  if (selected.length === 0) {
    display.innerHTML = "<p class='empty-state'>No products selected</p>";
    modal.classList.add("hidden");
    return;
  }

  display.classList.remove("empty-state");

  let index = 0;

  selected.forEach(cb => {
    const id = cb.value;

    const input = document.createElement("input");
    input.type = "hidden";
    input.name = `collection[product_collections_attributes][${index}][product_id]`;
    input.value = id;

    hiddenContainer.appendChild(input);

    const div = document.createElement("div");
    div.innerText = cb.nextElementSibling.innerText;
    display.appendChild(div);

    index++;
  });

  modal.classList.add("hidden");
};
</script>y