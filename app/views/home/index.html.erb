      </div>

      <div class="help-box">
        <div class="help-icon">
          <!-- Tools Icon -->
          <svg fill="none" viewBox="0 0 20 20" aria-hidden="true" class="text-component-icon w-11 h-11" height="32" width="32" data-component-name="icon"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" d="M16.41 5A1 1 0 1 1 15 3.59l1.67-1.67a3.5 3.5 0 0 0-5.06 3.97L5.9 11.6a3.5 3.5 0 0 0-3.97 5.06L3.59 15A1 1 0 0 1 5 16.41L3.37 18.1A3.5 3.5 0 0 0 8.4 14.1L14.1 8.4a3.5 3.5 0 0 0 3.97-5.06L16.4 5Z"></path><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" d="M7.75 9.75 5.5 7.5h-2l-2-4 2-2 4 2v2l2.25 2.25M9.75 12.75l5.04 5.04a1 1 0 0 0 1.42 0l1.58-1.58a1 1 0 0 0 0-1.42l-5.04-5.04"></path><path fill="currentColor" d="M10.9 11.6L11.6 10.9 17.35 16.65 16.65 17.35z"></path></svg>
        </div>
        <h3>Online courses</h3>
        <p>Lessons and tips from experts to help you succeed.</p>
      </div>

      <div class="help-box">
        <div class="help-icon">
          <!-- Users Icon -->
          <svg fill="none" viewBox="0 0 20 20" aria-hidden="true" class="text-component-icon w-11 h-11" height="32" width="32" data-component-name="icon"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" d="M7.5 15a3.5 3.5 0 0 1 3.5-3.5h4a3.5 3.5 0 0 1 3.5 3.5v2a.5.5 0 0 1-.5.5H8a.5.5 0 0 1-.5-.5v-2ZM6.5 11.5H5A3.5 3.5 0 0 0 1.5 15v2c0 .28.22.5.5.5h3.5"></path><circle cx="13" cy="6" r="3.5" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"></circle><circle cx="5.5" cy="7" r="2.5" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"></circle></svg>        </div>
        <h3>Shopify Partners</h3>
        <p>Do more with commerce's largest network of partners.</p>
      </div>

    </div>

  </div>
</section>

<section class="faq-section">
  <div class="faq-container">
    <h2 class="faq-title">Frequently asked questions</h2>

    <div class="faq-list">
      <%
        faqs = [
          {
            question: "How can I start my own online business?",
            answer: [
              "Choose a product or service to sell",
              "Research your target market",
              "Create an online store (Shopify, etc.)",
              "Set up payment methods",
              "Start marketing through social media and ads"
            ]
          },
          {
            question: "Can you start a business with no money?",
            answer: [
              "Yes, using dropshipping or service-based business",
              "Use free platforms like Instagram or Facebook",
              "Start with skills you already have",
              "Reinvest early profits into growth"
            ]
          },
          {
            question: "When should you start a business?",
            answer: [
              "Start when you have a clear idea",
              "When you are ready to learn and take risks",
              "No perfect time exists — start small and improve",
              "When you can commit consistent effort"
            ]
          },
          {
            question: "How can I get a business license for my online store?",
            answer: [
              "Check your local government requirements",
              "Register your business name",
              "Apply online or through business registration office",
              "Pay required fees and complete documentation"
            ]
          },
          {
            question: "What are the most successful small businesses?",
            answer: [
              "E-commerce stores (Shopify, Amazon)",
              "Digital marketing agencies",
              "Freelancing services (design, dev, writing)",
              "Online coaching or courses"
            ]
          },
          {
            question: "What is Shopify and how does it work?",
            answer: [
              "Shopify is an e-commerce platform",
              "It helps you create an online store easily",
              "You can add products, manage orders, and payments",
              "It handles hosting, security, and checkout system"
            ]
          }
        ]
      %>

      <% faqs.each do |question| %>
        <details class="faq-item">
          <summary class="faq-question">
            <span><%= question[:question] %></span>

            <div class="faq-icon-wrapper">
              <svg xmlns="http://www.w3.org/2000/svg"
                   class="faq-icon"
                   fill="none"
                   viewBox="0 0 24 24"
                   stroke="currentColor">
                <path stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M12 4v16m8-8H4" />
              </svg>
            </div>
          </summary>

          <div class="faq-answer">
            <ul>
              <% question[:answer].each do |point| %>
                <li><%= point %></li>
              <% end %>
            </ul>
          </div>
        </details>
      <% end %>
    </div>
  </div>
</section>

<section class="cta-section-new">
  <div class="cta-container-new">
    <h2 class="cta-heading-new">Your ideas. Our platform.</h2>
    
    <%= form_with url: "#", method: :post, class: "cta-form-new" do |f| %>
      <div class="input-group">
        <%= f.email_field :email, 
            placeholder: "Enter your email address", 
            class: "cta-input-new",
            required: true %>
        <%= f.submit "Start free trial", class: "cta-button-new" %>
      </div>
    <% end %>

    <p class="cta-disclaimer">
      You agree to receive Shopify marketing emails.
    </p>
  </div>
</section>

