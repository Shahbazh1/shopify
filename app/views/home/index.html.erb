      </div>

      <div class="help-box">
        <div class="help-icon">
          <!-- Apps Icon -->
          <svg fill="none" viewBox="0 0 20 20" aria-hidden="true" class="text-component-icon w-11 h-11" height="32" width="32" data-component-name="icon"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" d="M11.5 5.5h6m-3-3v6M16.5 11.5h-4a1 1 0 0 0-1 1v4a1 1 0 0 0 1 1h4a1 1 0 0 0 1-1v-4a1 1 0 0 0-1-1ZM7.5 11.5h-4a1 1 0 0 0-1 1v4a1 1 0 0 0 1 1h4a1 1 0 0 0 1-1v-4a1 1 0 0 0-1-1ZM7.5 2.5h-4a1 1 0 0 0-1 1v4a1 1 0 0 0 1 1h4a1 1 0 0 0 1-1v-4a1 1 0 0 0-1-1Z"></path></svg>
        </div>
        <h3>16K+ apps</h3>
