<nav class="shopify-navbar">
  <div class="nav-wrapper">

    <!-- LEFT: Logo -->
    <div class="nav-left">
      <%= link_to root_path do %>
        <img src="https://upload.wikimedia.org/wikipedia/commons/0/0e/Shopify_logo_2018.svg" class="logo">
      <% end %>
    </div>

    <!-- CENTER: Menu -->
    <ul class="nav-menu">
    </ul>

    <!-- RIGHT: Actions -->
    <div class="nav-right">
      <a href="#" class="btn-primary">Start for free</a>
    </div>

  </div>
</nav>

<section class="hero">
  <div class="hero-left">
    <h1>Start an online store for free</h1>
    
    <p class="subtitle">
      Shopify is the all-in-one platform to build, run, and grow your online boutique.
      Start free, then get 3 months for US$1/month
    </p>

    <div class="cta-box">
      <input type="email" placeholder="Enter your email address">
      <button>Start free trial</button>
    </div>

    <p class="note">
      You agree to receive Shopify marketing emails.
    </p>
  </div>

  <div class="hero-right">
    <%= image_tag "https://cdn.shopify.com/b/shopify-brochure2-assets/ae3bb5026b18f6e9246facb6adaba75e.png?originalWidth=1680&originalHeight=1260", alt: "Shop UI" %>  
  </div>
</section>

<section class="brands">
  <h3>Powering millions of businesses worldwide</h3>

  <div class="brand-slider">
    <div class="brand-track">
      <% 2.times do %>
        <img src="https://cdn.shopify.com/b/shopify-brochure2-assets/d7d665c21caba6bf4e58aea093f60a0c.svg" />
        <img src="https://cdn.shopify.com/b/shopify-brochure2-assets/4a6ab9bbbf33ac29cf1747e48492a14e.svg" />
        <img src="https://cdn.shopify.com/b/shopify-brochure2-assets/f000a563db2c785b97ea90a1a2695c1e.svg" />
        <img src="https://cdn.shopify.com/b/shopify-brochure2-assets/2075ad1e1e60e6fa121f54a1bfe4185c.svg" />
        <img src="https://cdn.shopify.com/b/shopify-brochure2-assets/bb1480775c17a84b2787e71d4b8b5c72.svg" />
      <% end %>
    </div>
  </div>
</section>

<section class="smart-selling">
  <div class="container">

    <h2 class="heading">Smarter selling starts here</h2>

    <div class="cards">

      <!-- Card 1 -->
      <div class="card">
        <img src="https://cdn.shopify.com/b/shopify-brochure2-assets/4f40535cf7d14b8acf660db59210cf5e.png?originalWidth=640&originalHeight=380" class="card-img" />
        <h3>World's best checkout</h3>
        <p>
          Fast, flexible, and converts 15% better than other platforms, on average.
        </p>
      </div>

      <!-- Card 2 -->
      <div class="card">
        <img src="https://cdn.shopify.com/b/shopify-brochure2-assets/528da6ade6449e40e8d6d06426934b7d.png" class="card-img" />
        <h3>Built-in AI tools</h3>
        <p>
          Get more done with AI functionality that's built into every store.
        </p>
      </div>

      <!-- Card 3 -->
      <div class="card">
        <img src="https://cdn.shopify.com/b/shopify-brochure2-assets/8f6a2d3265162c013e9b54753b2a3f0d.png?originalWidth=1280&originalHeight=760" class="card-img" />
        <h3>Fast, reliable hosting</h3>
        <p>
          Our 99.9% uptime keeps your store running smoothly, day and night.
        </p>
      </div>

    </div>

    <!-- Quote -->
    <div class="quote">
      <p>
        “Every Shopify plan comes with unlimited storage...and products, which means Shopify scales beautifully as your business grows.”
      </p>

      <div class="quote-footer">
        <strong>Forbes</strong><br>
        <span>Janette Novak — Advisor</span>
      </div>
    </div>

  </div>
</section>

<section class="cta-section">
  <div class="cta-container">

    <h2 class="cta-heading">
      Join millions growing with Shopify
    </h2>

    <form class="cta-form">
      <input 
        type="email" 
        placeholder="Enter your email address" 
        class="cta-input"
      />

      <button type="submit" class="cta-button">
        Start free trial
      </button>
    </form>

    <p class="cta-subtext">
      You agree to receive Shopify marketing emails.
    </p>

  </div>
</section>

<section class="commerce-section">
  <div class="commerce-container">
    
    <h1 class="commerce-container-heading">
      The global platform for commerce
    </h1>

    <div class="commerce-container-stats-wrapper">
      
      <div class="stat-card">
        <h2>$11+ trillion</h2>
        <p>Total sales through Shopify worldwide.</p>
      </div>

      <div class="stat-card">
        <h2>175+ countries</h2>
        <p>With businesses powered by Shopify.</p>
      </div>

    </div>

  </div>
</section>

