<!-- app/views/discounts/_empty.html.erb -->

<div class="discounts-page">

  <!-- Header -->
  <div class="discounts-header">
    <div class="discounts-title">
      <span class="discount-icon">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 20 20">
          <path d="M7.5 5.833A1.667 1.667 0 1 1 5.833 7.5 1.667 1.667 0 0 1 7.5 5.833Zm5 6.667a1.667 1.667 0 1 1-1.667 1.667 1.667 1.667 0 0 1 1.667-1.667ZM5 15l10-10"
                stroke="#616161"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"/>
        </svg>
      </span>

      <h1>Discounts</h1>
    </div>

    <div class="discounts-actions">
      <button class="export-btn" disabled>Export</button>
      <button type="button" class="create-btn" onclick="event.preventDefault(); document.getElementById('discountPopup').style.display='flex'">Create discount</button>
    </div>
  </div>

  <!-- Empty State Card -->
  <div class="discounts-empty-card">

    <!-- Illustration -->
    <div class="discount-illustration">

      <div class="circle-bg">
        <img src="https://cdn.shopify.com/shopifycloud/web/assets/v1/vite/client/en/assets/empty-state-discount-08a97f868909.svg"
             alt="Discount Illustration" />
      </div>

    </div>

    <!-- Content -->
    <h2>Manage discounts and promotions</h2>

    <p>
      Add discount codes and automatic discounts that apply at checkout.
      <br>
      You can also use discounts with
      <a href="#">compare at prices</a>.
    </p>

    <button type="button" class="center-create-btn" onclick="event.preventDefault(); document.getElementById('discountPopup').style.display='flex'">Create discount</button>
  </div>

  <div class="learn-more">
    Learn more about discounts
  </div>
</div>

<style>
/* =========================
   BASE PAGE
========================= */
.discounts-page {
  background: #f6f6f7;
  min-height: 100vh;
  padding: 16px;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

/* =========================
   HEADER
========================= */
.discounts-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16px;
}

.discounts-title {
  display: flex;
  align-items: center;
  gap: 10px;
}

.discount-icon {
  width: 28px;
  height: 28px;
  border-radius: 8px;
  border: 1px solid #d9d9d9;
  background: white;
  display: flex;
  align-items: center;
  justify-content: center;
}

.discounts-title h1 {
  font-size: 16px;
  font-weight: 600;
  color: #303030;
  margin: 0;
}

/* =========================
   BUTTON SYSTEM (UNIFIED)
========================= */
.export-btn,
.create-btn,
.center-create-btn {
  height: 36px;
  padding: 0 14px;
  border-radius: 10px;
  font-size: 13px;
  font-weight: 600;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  cursor: pointer;
}

/* Disabled export */
.export-btn {
  border: 1px solid #dcdcdc;
  background: #f1f1f1;
  color: #b5b5b5;
  cursor: not-allowed;
}

/* Primary button */
.create-btn,
.center-create-btn {
  border: 1px solid #1f1f1f;
  background: #1f1f1f;
  color: #ffffff !important;
}

/* =========================
   EMPTY CARD
========================= */
.discounts-empty-card {
  background: white;
  border: 1px solid #dfdfdf;
  border-radius: 16px;
  min-height: 420px;
  padding: 32px 24px;

  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

/* =========================
   ILLUSTRATION
========================= */
.discount-illustration {
  position: relative;
  width: 140px;
  height: 140px;
  margin-bottom: 14px;
}

.circle-bg {
  position: absolute;
  width: 110px;
  height: 110px;
  border-radius: 50%;
  background: #e9e9e9;

  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);

  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.circle-bg img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  display: block;
}

/* =========================
   TEXT CONTENT
========================= */
.discounts-empty-card h2 {
  font-size: 18px;
  font-weight: 600;
  color: #303030;
  margin: 6px 0 8px;
}

.discounts-empty-card p {
  font-size: 14px;
  color: #616161;
  line-height: 22px;
  margin: 0;
}

.discounts-empty-card a {
  color: #303030;
  text-decoration: underline;
}

/* =========================
   CENTER BUTTON SPACING
========================= */
.center-create-btn {
  margin-top: 16px;
}

/* =========================
   FOOTER LINK
========================= */
.learn-more {
  text-align: center;
  margin-top: 24px;
  color: #303030;
  font-size: 14px;
  font-weight: 600;
}
</style>

<%= render 'discounts/discount_popup' %>