<%= form_with model: @discount, url: discounts_path, method: :post do |f| %>
  <%= f.hidden_field :discount_type, value: @discount_type %>
  <!-- Replace the old hidden inputs with this container -->
<div id="hidden-inputs-container"></div>
<!-- BROWSE MODAL -->
<div class="browse-modal-overlay" id="browse-modal">
  <div class="browse-modal">

    <div class="browse-modal-header">
      <h3 id="modal-title">Select Items</h3>

      <button type="button" id="close-modal">
        ✕
      </button>
    </div>

    <div class="browse-search">
      <input type="text" placeholder="Search...">
    </div>

    <!-- app/views/discounts/new.html.erb -->

<div class="browse-list" id="browse-list">
  
  <!-- DYNAMIC COLLECTIONS -->
  <% @collections.each do |collection| %>
    <div class="browse-item collection-item">
      <label>
        <input type="checkbox" value="<%= collection.id %>" data-name="<%= collection.title %>">
        <%= collection.title %>
      </label>
    </div>
  <% end %>

  <!-- DYNAMIC PRODUCTS -->
  <% @products.each do |product| %>
    <div class="browse-item product-item">
      <label>
        <input type="checkbox" value="<%= product.id %>" data-name="<%= product.title %>">
        <%# If you have images, you could add: <%= image_tag product.image_url, width: 30 if product.image_url %>
        <%= product.title %>
      </label>
    </div>
  <% end %>

</div>

    <div class="browse-footer">
      <button type="button" id="save-selection-btn">
        Done
      </button>
    </div>

  </div>
</div>
<div class="discount-create-page">

  <!-- Top Header -->
  <div class="top-header">
    <div class="breadcrumb">
      <span class="arrow">‹</span>
      <span>Create discount</span>
    </div>
  </div>

  <div class="discount-layout">

    <!-- LEFT SIDE -->
    <div class="left-section">

      <!-- type of discount -->
      <div class="card">
        <h3><%= @discount_type.capitalize %></h3>

        <div class="field-group">
  <label>Method</label>
  <div class="method-tabs" id="method-toggle">
    <button class="tab active" type="button" data-value="code">
      Discount code
      <input type="radio" name="discount[discount_method]" value="code" hidden checked>
    </button>

    <button class="tab" type="button" data-value="automatic">
      Automatic discount
      <input type="radio" name="discount[discount_method]" value="automatic" hidden>
    </button>
  </div>
</div>

        <div class="field-group">
  <div class="label-row" id="code-label-row">
    <label>Discount code</label>
    <a href="#" id="generate-code">Generate random code</a>
  </div>

  <input type="text" name="discount[discount_code]" id="discount-code-input">

  <p class="helper-text" id="code-helper-text">
  Customers must enter this code at checkout.
</p>
</div>

<!-- TITLE FIELD -->
<div class="field-group" id="title-field" style="display:none;">
  <label>Discount title</label>
  <input type="text" name="discount[discount_title]" id="discount-title-input">
</div>
      </div>

      <!-- Discount Value -->
      <% if @discount_type == "amount_off_products" || @discount_type == "amount_off_order" %>
      <div class="card">
        <h3>Discount</h3>

        <div class="discount-value-row">
          <select name="discount[value_type]" id="value-type-select">
            <option value="percentage">Percentage</option>
            <option value="fixed">Fixed</option>
          </select>

          <div class="percent-box">
            <input type="text" name="discount[value]">
            <span id="value-symbol">%</span>
          </div>
        </div>
        <% if @discount_type == "amount_off_products" %>
          <div class="field-group mt-16">
            <label>Applies to</label>

            <select name="discount[applies_to]" id="applies-to">
            <option value="collections">Collections</option>
            <option value="products">Products</option>
            </select>
          </div>
        

           <div class="search-row">
            <div class="search-box">
              <span>⌕</span>
              <input type="text" placeholder="Search collections">
            </div>

            <button class="browse-btn" type="button">Browse</button>
            <div id="hidden-inputs-container"></div>

            <div id="selected-items-preview"></div>
          </div>
        <% end %>

      </div>
    <% end%>

      <!-- Active Dates -->
      <div class="card">
        <h3>Active dates</h3>

        <div class="date-grid">
          <div>
            <label>Start date</label>
            <input type="date" name="discount[start_date]">
          </div>

        </div>

        <label class="checkbox-option mt-16">
          <input type="checkbox" value="1">
          <span>Set end date</span>
        </label>

        <input type="date" name="discount[end_date]">
      </div>
    </div>

    <!-- RIGHT SIDEBAR -->
    <div class="right-section">

      <div class="card side-card">
        <h4>No discount code yet</h4>

        <div class="summary-group">
          <span class="summary-title">Code</span>
        </div>

        <div class="summary-group">
          <span class="summary-title">Type</span>

          <div class="summary-value">
            <span class="tag-icon">🏷</span>
            Product discount
          </div>
        </div>

        <div class="divider"></div>

        <div class="summary-group">
          <span class="summary-title">Details</span>

          <ul class="details-list">
            <li>All customers</li>
            <li>For Online Store</li>
            <li>No minimum purchase requirement</li>
            <li>No usage limits</li>
            <li>Can’t combine with other discounts</li>
            <li>Active from today</li>
          </ul>
        </div>
      </div>

      <div class="card side-card">
        <h4>Sales channels access</h4>

        <label class="checkbox-option">
          <input type="checkbox">
          <span>Allow discount to be featured on selected channels</span>
        </label>
      </div>

      <div class="card side-card">
        <h4>Tags</h4>

        <button class="tag-btn" type="button">⊕ Add tags</button>
      </div>
    </div>
  </div>

  <!-- Save Button -->
  <div class="bottom-save">
    <button type="submit">Save</button>
  </div>

</div>

<% end %>

<style>
/* MODAL */

.browse-modal-overlay{
  position:fixed;
  inset:0;
  background:rgba(0,0,0,0.4);
  display:none;
  align-items:center;
  justify-content:center;
  z-index:9999;
}

.browse-modal{
  width:500px;
  max-width:95%;
  background:white;
  border-radius:14px;
  overflow:hidden;
}

.browse-modal-header{
  display:flex;
  justify-content:space-between;
  align-items:center;
  padding:14px;
  border-bottom:1px solid #e5e5e5;
}

.browse-modal-header h3{
  margin:0;
  font-size:15px;
}

.browse-modal-header button{
  border:none;
  background:none;
  font-size:18px;
  cursor:pointer;
}

.browse-search{
  padding:14px;
  border-bottom:1px solid #eee;
}

.browse-search input{
  width:100%;
}

.browse-list{
  max-height:300px;
  overflow:auto;
}

.browse-item{
  padding:12px 14px;
  border-bottom:1px solid #f1f1f1;
}

.browse-item label{
  display:flex;
  align-items:center;
  gap:10px;
  margin:0;
  cursor:pointer;
}

.browse-footer{
  padding:14px;
  display:flex;
  justify-content:flex-end;
  border-top:1px solid #eee;
}

.browse-footer button{
  height:34px;
  padding:0 16px;
  border:none;
  border-radius:8px;
  background:#005bd3;
  color:white;
  cursor:pointer;
}

#selected-items-preview{
  margin-top:12px;
  display:flex;
  flex-wrap:wrap;
  gap:8px;
}

.selected-tag{
  background:#f1f1f1;
  border-radius:20px;
  padding:6px 12px;
  font-size:12px;
}
/* Ensure the active tab looks "pressed" or selected */
.tab.active {
  background: white;
  font-weight: 600;
  box-shadow: inset 0 0 0 1px #005bd3; /* Optional: adds a blue ring when active */
  color: #005bd3;
}

.tab {
  transition: all 0.2s ease; /* Smooth transition for the toggle */
}
  body {
    margin: 0;
    background: #f6f6f7;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    color: #303030;
  }

  .discount-create-page {
    padding: 18px;
  }

  /* HEADER */

  .top-header {
    margin-bottom: 14px;
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 15px;
    font-weight: 600;
  }

  .arrow {
    font-size: 22px;
    line-height: 1;
    margin-top: -2px;
  }

  /* LAYOUT */

  .discount-layout {
    display: grid;
    grid-template-columns: 1fr 250px;
    gap: 16px;
    align-items: start;
  }

  .left-section {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .right-section {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  /* CARD */

  .card {
    background: white;
    border: 1px solid #dcdcdc;
    border-radius: 12px;
    padding: 14px;
    box-shadow: 0 1px 0 rgba(0,0,0,0.02);
  }

  .card h3,
  .card h4 {
    margin: 0 0 14px;
    font-size: 13px;
    font-weight: 600;
    color: #303030;
  }

  /* FIELDS */

  .field-group {
    margin-bottom: 14px;
  }

  label {
    display: block;
    font-size: 12px;
    color: #616161;
    margin-bottom: 6px;
  }

  input[type="text"],
  input[type="date"],
  select {
    width: 100%;
    height: 32px;
    border: 1px solid #8a8a8a;
    border-radius: 6px;
    padding: 0 10px;
    font-size: 12px;
    background: white;
    box-sizing: border-box;
  }

  .helper-text {
    margin: 6px 0 0;
    font-size: 11px;
    color: #8a8a8a;
  }

  .label-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .label-row a {
    font-size: 11px;
    text-decoration: none;
    color: #005bd3;
  }

  /* TABS */

  .method-tabs {
    display: inline-flex;
    border: 1px solid #d0d0d0;
    border-radius: 8px;
    overflow: hidden;
  }

  .tab {
    height: 28px;
    padding: 0 12px;
    border: none;
    background: #f6f6f7;
    font-size: 12px;
    cursor: pointer;
  }

  .tab.active {
    background: white;
    font-weight: 600;
  }

  /* DISCOUNT VALUE */

  .discount-value-row {
    display: grid;
    grid-template-columns: 1fr 100px;
    gap: 10px;
  }

  .percent-box {
    position: relative;
  }

  .percent-box span {
    position: absolute;
    right: 10px;
    top: 7px;
    font-size: 13px;
    color: #616161;
  }

  .search-row {
    display: flex;
    gap: 8px;
    margin-top: 10px;
  }

  .search-box {
    flex: 1;
    position: relative;
  }

  .search-box span {
    position: absolute;
    left: 10px;
    top: 7px;
    color: #8a8a8a;
    font-size: 13px;
  }

  .search-box input {
    padding-left: 28px;
  }

  .browse-btn {
    height: 32px;
    padding: 0 12px;
    border-radius: 6px;
    border: 1px solid #c9c9c9;
    background: white;
    font-size: 12px;
    cursor: pointer;
  }

  /* OPTIONS */

  .radio-option,
  .checkbox-option {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    margin-bottom: 10px;
    color: #303030;
  }

  .radio-option input,
  .checkbox-option input {
    margin: 0;
  }

  /* DATE GRID */

  .date-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }

  /* SIDEBAR */

  .summary-title {
    font-size: 11px;
    color: #8a8a8a;
    display: block;
    margin-bottom: 6px;
  }

  .summary-value {
    font-size: 12px;
    display: flex;
    align-items: center;
    gap: 5px;
  }

  .divider {
    height: 1px;
    background: #ececec;
    margin: 14px 0;
  }

  .details-list {
    padding-left: 16px;
    margin: 8px 0 0;
    font-size: 12px;
    color: #303030;
    line-height: 1.8;
  }

  .tag-btn {
    width: 100%;
    height: 32px;
    border: 1px solid #c9c9c9;
    border-radius: 6px;
    background: white;
    font-size: 12px;
    text-align: left;
    padding: 0 10px;
    cursor: pointer;
  }

  /* SAVE */

  .bottom-save {
    display: flex;
    justify-content: flex-end;
    margin-top: 18px;
  }

  .bottom-save button {
    width: 56px;
    height: 28px;
    border: none;
    border-radius: 8px;
    background: green;
    color: white;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
  }

  .mt-16 {
    margin-top: 16px;
  }

  @media (max-width: 991px) {
    .discount-layout {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
  const tabs = document.querySelectorAll('#method-toggle .tab');
  const codeInput = document.getElementById('discount-code-input');
  const titleField = document.getElementById('title-field');
  const titleInput = document.getElementById('discount-title-input');
  const generateBtn = document.getElementById('generate-code');

 function updateUI() {
  const selected = document.querySelector('input[name="discount[discount_method]"]:checked').value;

  const codeInput = document.getElementById('discount-code-input');
  const codeLabel = document.getElementById('code-label-row');
  const helperText = document.getElementById('code-helper-text');
  const titleField = document.getElementById('title-field');

  if (selected === 'automatic') {
    // ❌ hide everything related to code
    codeInput.value = "";
    codeInput.disabled = true;
    codeInput.style.display = "none";
    codeLabel.style.display = "none";
    helperText.style.display = "none";

    // ✅ show title
    titleField.style.display = "block";
  } 
  else {
    // ✅ show code section
    codeInput.disabled = false;
    codeInput.style.display = "block";
    codeLabel.style.display = "flex";
    helperText.style.display = "block";

    // ❌ hide title
    titleField.style.display = "none";
    document.getElementById('discount-title-input').value = "";
  }
}

  // Tabs click
  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      tabs.forEach(t => t.classList.remove('active'));
      tab.classList.add('active');

      const radio = tab.querySelector('input[type="radio"]');
      radio.checked = true;

      updateUI();
    });
  });

  // Generate code (only when code mode active)
  generateBtn.addEventListener('click', (e) => {
    e.preventDefault();

    const selected = document.querySelector('input[name="discount[discount_method]"]:checked').value;
    if (selected !== 'code') return; // 🔥 block if automatic selected

    const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';
    let code = '';

    for (let i = 0; i < 10; i++) {
      code += chars.charAt(Math.floor(Math.random() * chars.length));
    }

    codeInput.value = code;
  });

  updateUI();
});

// VALUE TYPE SYMBOL CHANGE
const valueTypeSelect = document.getElementById('value-type-select');
const valueSymbol = document.getElementById('value-symbol');

function updateValueSymbol() {
  if (valueTypeSelect.value === 'fixed') {
    valueSymbol.textContent = 'Rs';
  } else {
    valueSymbol.textContent = '%';
  }
}

valueTypeSelect.addEventListener('change', updateValueSymbol);

// Initial call
updateValueSymbol();

const browseBtn = document.querySelector('.browse-btn');
const browseModal = document.getElementById('browse-modal');
const closeModal = document.getElementById('close-modal');
const appliesToSelect = document.querySelector('select[name="discount[applies_to]"]');
const modalTitle = document.getElementById('modal-title');

const collectionItems = document.querySelectorAll('.collection-item');
const productItems = document.querySelectorAll('.product-item');

const saveSelectionBtn = document.getElementById('save-selection-btn');

const preview = document.getElementById('selected-items-preview');

browseBtn.addEventListener('click', () => {
  const selectedType = appliesToSelect.value;
  browseModal.style.display = 'flex';

  if (selectedType === 'collections') {            // ← matches <option value="collections">
    modalTitle.textContent = 'Select Collections';
    collectionItems.forEach(item => item.style.display = 'block');
    productItems.forEach(item => item.style.display = 'none');
  } else {
    modalTitle.textContent = 'Select Products';
    collectionItems.forEach(item => item.style.display = 'none');
    productItems.forEach(item => item.style.display = 'block');
  }
});

closeModal.addEventListener('click', () => {
  browseModal.style.display = 'none';
});

saveSelectionBtn.addEventListener('click', () => {
  const selectedType = appliesToSelect.value;
  const checkedInputs = browseModal.querySelectorAll('input[type="checkbox"]:checked');

  const hiddenContainer = document.getElementById('hidden-inputs-container');

  preview.innerHTML = '';
  hiddenContainer.innerHTML = '';

  checkedInputs.forEach((input, index) => {
    const id = input.value;
    const name = input.dataset.name;

    preview.innerHTML += `<div class="selected-tag">${name}</div>`;

    // ✅ PRODUCT NESTED ATTRIBUTES
    if (selectedType === 'products') {

      hiddenContainer.innerHTML += `
        <input type="hidden"
          name="discount[product_discounts_attributes][${index}][product_id]"
          value="${id}">
      `;
    }

    // ✅ COLLECTION NESTED ATTRIBUTES
    else {

      hiddenContainer.innerHTML += `
        <input type="hidden"
          name="discount[collection_discounts_attributes][${index}][collection_id]"
          value="${id}">
      `;
    }
  });

  browseModal.style.display = 'none';
});
</script>