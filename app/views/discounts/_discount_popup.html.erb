<!-- Discount Type Popup Modal -->

<div class="discount-modal-overlay" id="discountPopup" style="display: none;">

  <div class="discount-modal">

    <!-- Header -->
    <div class="discount-modal-header">
      <h2>Select discount type</h2>

      <button class="close-btn" onclick="document.getElementById('discountPopup').style.display='none'">
        ✕
      </button>
    </div>

    <!-- Options -->
    <div class="discount-options">

      <!-- Option -->
      <a href="<%= new_discount_path(store_id: params[:store_id], discount_type: 'amount_off_products') %>" class="discount-option" style="text-decoration: none; color: inherit;">
        <div class="option-left">

          <div class="option-icon">
            🏷
          </div>

          <div class="option-content">
            <h3>Amount off products</h3>
            <p>Discount specific products or collections of products</p>
          </div>
        </div>

        <div class="option-arrow">›</div>
      </a>

      <!-- Option -->
      <a href="<%= new_discount_path(store_id: params[:store_id], discount_type: 'buy_x_get_y') %>" class="discount-option" style="text-decoration: none; color: inherit;">
        <div class="option-left">

          <div class="option-icon">
            🏷
          </div>

          <div class="option-content">
            <h3>Buy X get Y</h3>
            <p>Discount specific products or collections of products</p>
          </div>
        </div>

        <div class="option-arrow">›</div>
      </a>

      <!-- Option -->
      <a href="<%= new_discount_path(store_id: params[:store_id], discount_type: 'amount_off_order') %>" class="discount-option" style="text-decoration: none; color: inherit;">
        <div class="option-left">

          <div class="option-icon">
            👜
          </div>

          <div class="option-content">
            <h3>Amount off order</h3>
            <p>Discount the total order amount</p>
          </div>
        </div>

        <div class="option-arrow">›</div>
      </a>

      <!-- Option -->
      <a href="<%= new_discount_path(store_id: params[:store_id], discount_type: 'free_shipping') %>" class="discount-option" style="text-decoration: none; color: inherit;">
        <div class="option-left">

          <div class="option-icon">
            🚚
          </div>

          <div class="option-content">
            <h3>Free shipping</h3>
            <p>Offer free shipping on an order</p>
          </div>
        </div>

        <div class="option-arrow">›</div>
      </a>
    </div>

    <!-- Footer -->
    <div class="discount-modal-footer">
      <button class="cancel-btn" onclick="document.getElementById('discountPopup').style.display='none'">
        Cancel
      </button>
    </div>
  </div>
</div>

<style>

  body{
    margin:0;
    font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
  }

  /* OVERLAY */

  .discount-modal-overlay{
    position:fixed;
    inset:0;
    background:rgba(0,0,0,0.42);
    display:flex;
    align-items:flex-start;
    justify-content:center;
    padding-top:70px;
    z-index:9999;
  }

  /* MODAL */

  .discount-modal{
    width:930px;
    background:white;
    border-radius:24px;
    overflow:hidden;
    box-shadow:
      0 18px 40px rgba(0,0,0,0.16),
      0 2px 6px rgba(0,0,0,0.08);
  }

  /* HEADER */

  .discount-modal-header{
    height:78px;
    padding:0 24px;
    display:flex;
    align-items:center;
    justify-content:space-between;
    border-bottom:1px solid #e3e3e3;
  }

  .discount-modal-header h2{
    margin:0;
    font-size:22px;
    font-weight:650;
    color:#303030;
  }

  .close-btn{
    width:36px;
    height:36px;
    border:none;
    background:transparent;
    border-radius:10px;
    font-size:20px;
    color:#8a8a8a;
    cursor:pointer;
    transition:0.2s;
  }

  .close-btn:hover{
    background:#f1f1f1;
  }

  /* OPTIONS */

  .discount-options{
    width:100%;
  }

  .discount-option{
    height:103px;
    padding:0 24px;
    display:flex;
    align-items:center;
    justify-content:space-between;
    border-bottom:1px solid #e7e7e7;
    cursor:pointer;
    transition:0.15s;
  }

  .discount-option:hover{
    background:#fafafa;
  }

  .option-left{
    display:flex;
    align-items:flex-start;
    gap:18px;
  }

  .option-icon{
    width:26px;
    height:26px;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:20px;
    margin-top:2px;
  }

  .option-content h3{
    margin:0 0 10px;
    font-size:18px;
    font-weight:650;
    color:#303030;
  }

  .option-content p{
    margin:0;
    font-size:16px;
    color:#616161;
    line-height:1.4;
  }

  .option-arrow{
    font-size:42px;
    color:#8a8a8a;
    line-height:1;
    margin-top:-4px;
  }

  /* FOOTER */

  .discount-modal-footer{
    height:88px;
    padding:0 24px;
    display:flex;
    align-items:center;
    justify-content:flex-end;
    background:white;
  }

  .cancel-btn{
    height:42px;
    padding:0 18px;
    border-radius:14px;
    border:1px solid #cfcfcf;
    background:white;
    font-size:16px;
    font-weight:600;
    color:#303030;
    cursor:pointer;
    transition:0.15s;
  }

  .cancel-btn:hover{
    background:#f6f6f7;
  }

</style>