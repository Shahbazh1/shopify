    <!-- Discounts (no submenu) -->
    <!-- Discounts (no submenu) -->
<a href="<%= discounts_path(store_id: params[:store_id]) %>" 
   class="nav-item <%= 'active' if current_page?(discounts_path(store_id: params[:store_id])) %>">
