<style>
:root {
  --shopify-top-bar: #1a1a1a;
  --shopify-sidebar: #ebebeb;
  --shopify-bg: #f1f1f1;
  --shopify-text: #303030;
  --shopify-border: #e1e3e5;
  --shopify-active-item: #f1f1f1;
  --shopify-hover: #eaeaea;
  --shopify-search-bg: #303030;
  --shopify-trial-card: #1a1a1a;
}

/* RESET */
* {
  box-sizing: border-box;
}

body, html {
  margin: 0;
  padding: 0;
  height: 100%;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  color: var(--shopify-text);
  background: var(--shopify-bg);
}

/* APP WRAPPER */
.dashboard-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
}


/* =========================
   TOP NAV BAR
========================= */

.top-nav {
  height: 56px;
  background: var(--shopify-top-bar);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 14px;
  color: white;
  position: sticky;
  top: 0;
  z-index: 1000;
}

/* LOGO */
.logo {
  display: flex;
  align-items: center;
  gap: 10px;
}

.logo i {
  font-size: 22px;
}

.logo img {
  height: 20px;
  object-fit: contain;
}

/* SEARCH */
.search-container {
  flex: 1;
  max-width: 600px;
  margin: 0 20px;
  position: relative;
}

.search-input {
  width: 100%;
  background: #303030;
  border: 1px solid #454545;
  border-radius: 8px;
  padding: 8px 36px;
  color: white;
  font-size: 14px;
  outline: none;
}

.search-icon {
  position: absolute;
  left: 12px;
  top: 50%;
  transform: translateY(-50%);
  color: #aaa;
}

.search-shortcut {
  position: absolute;
  right: 10px;
  top: 50%;
  transform: translateY(-50%);
  font-size: 10px;
  background: #4a4a4a;
  padding: 2px 6px;
  border-radius: 4px;
}

/* RIGHT SIDE */
.top-icons {
  display: flex;
  align-items: center;
  gap: 14px;
}

/* SVG ICONS */
.top-icons svg {
  width: 18px;
  height: 18px;
  fill: white;
  opacity: 0.85;
  cursor: pointer;
  transition: 0.2s;
}

.top-icons svg:hover {
  opacity: 1;
  transform: scale(1.08);
}

/* STORE SWITCHER */
.store-switcher {
  background: #303030;
  padding: 4px 8px;
  border-radius: 6px;
  display: flex;
  align-items: center;
  gap: 6px;
  cursor: pointer;
}

.store-switcher span:first-child {
  background: #10b981;
  font-size: 10px;
  padding: 1px 4px;
  border-radius: 3px;
}

.store-switcher span:last-child {
  font-size: 12px;
  font-weight: 500;
}

/* =========================
   RESPONSIVE
========================= */

@media (max-width: 768px) {
  .search-container {
    display: none;
  }

  .logo img {
    height: 16px;
  }

  .top-icons svg {
    width: 16px;
    height: 16px;
  }

  .store-switcher span:last-child {
    display: none;
  }
}

/* LAYOUT */
.layout-body {
  display: flex;
  flex: 1;
  overflow: hidden;
  background: #1a1a1a
}

/* SIDEBAR */
.sidebar {
  width: 260px;
  background: var(--shopify-sidebar);
  display: flex;
  flex-direction: column;
  padding: 10px;
  overflow-y: auto;
  border-top-left-radius: 12px;
}

.nav-item {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 8px 10px;
  border-radius: 8px;
  font-size: 14px;
  font-weight: 500;
  color: #333;
  text-decoration: none;
  transition: all 0.15s ease-in-out;
  position: relative;
}

/* 🔥 HOVER EFFECT (light white like Shopify) */
.nav-item:hover {
  background: rgba(255, 255, 255, 0.8);
}

/* 🔥 ACTIVE ITEM */
.nav-item.active {
  background: #ffffff;
  font-weight: 600;
  box-shadow: 0 1px 2px rgba(0,0,0,0.08);
}

/* 🔥 LEFT INDICATOR BAR (Shopify style feel) */
.nav-item.active::before {
  content: "";
  position: absolute;
  left: 0;
  top: 8px;
  bottom: 8px;
  width: 3px;
  background: #1a1a1a;
  border-radius: 4px;
}

/* optional: make icon darker on active */
.nav-item.active i {
  color: #1a1a1a;
}

/* NESTED MENU */
.sidebar-section-title {
  margin-top: 10px;
  font-size: 11px;
  font-weight: 600;
  color: #6d7175;
  text-transform: uppercase;
  padding: 10px 10px 4px;
}

/* TRIAL CARD */
.trial-card {
  margin-top: auto;
  background: #1a1a1a;
  border-radius: 12px;
  padding: 14px;
  color: white;
}

.trial-card p {
  font-size: 12px;
  margin: 0;
  opacity: 0.7;
}

.trial-cta {
  font-size: 14px;
  font-weight: 700;
  margin-top: 6px;
}

.subscribe-btn {
  width: 100%;
  margin-top: 10px;
  padding: 8px;
  border-radius: 8px;
  border: none;
  font-weight: 600;
  cursor: pointer;
}

/* MAIN CONTENT */
.main-content {
  flex: 1;
  overflow-y: auto;
  padding: 24px;
  background: var(--shopify-bg);
  border-top-right-radius: 12px;
  padding-top: 0px;

}

.content-wrapper {
  max-width: 1100px;
  margin: 0 auto;
}

/* =========================
   RESPONSIVE DESIGN
========================= */

/* TABLET */
@media (max-width: 1024px) {
  .sidebar {
    width: 220px;
  }

  .search-container {
    max-width: 400px;
  }
}

/* MOBILE */
@media (max-width: 768px) {
  .sidebar {
    position: fixed;
    left: -260px;
    top: 56px;
    height: calc(100vh - 56px);
    transition: 0.3s ease;
    z-index: 999;
border-top-left-radius: 12px;
  }

  .sidebar.open {
    left: 0;
  }

  .main-content {
    padding: 16px;
  }

  .search-container {
    display: none;
  }
}

/* SMALL MOBILE */
@media (max-width: 480px) {
  .top-nav {
    padding: 0 10px;
  }

  .main-content {
    padding: 12px;
  }
}

/* SUBMENU */
.submenu {
  display: none;
  padding-left: 34px;
  margin-top: 4px;
}

.submenu-item {
  display: block;
  padding: 6px 10px;
  font-size: 13px;
  color: #555;
  text-decoration: none;
  border-radius: 6px;
}

.submenu-item:hover {
  background: rgba(255,255,255,0.7);
}

/* SHOW ACTIVE MENU */
.menu-group.active .submenu {
  display: block;
}

/* ARROW */
.arrow {
  margin-left: auto;
  font-size: 10px;
  transition: 0.2s;
}

.menu-group.active .arrow {
  transform: rotate(180deg);
}
</style>

<!DOCTYPE html>
<html>
  <head>
    <title>Shopify Admin</title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  </head>

  <script>
document.addEventListener("DOMContentLoaded", function () {

  const menuGroups = document.querySelectorAll(".menu-group");

  menuGroups.forEach(group => {
    const trigger = group.querySelector(".has-submenu");

    trigger.addEventListener("click", function () {

      // Close all other menus
      menuGroups.forEach(g => {
        if (g !== group) {
          g.classList.remove("active");
        }
      });

      // Toggle current menu
      group.classList.toggle("active");
    });
  });

});
</script>

