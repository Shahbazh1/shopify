<div class="shopify-orders-page">

  <!-- HEADER -->
  <div class="orders-topbar">
    <div class="orders-title-section">
      <h1>Orders</h1>
    </div>

    <div class="orders-actions">
      <%= link_to "Create draft order", new_draft_order_path(@store), class: "create-order-btn" %>

    </div>
  </div>

  <!-- TABLE CARD -->
  <div class="orders-card">

    <!-- FILTER BAR -->
    <div class="orders-filter-bar">

      <div class="orders-filter-left">

        <div class="filter-dropdown">
          All
          <span>⌄</span>
        </div>

        <div class="orders-search">
          <span class="search-icon">🔍</span>

          <input type="text"
                 placeholder="Search and filter">
        </div>

      </div>

      <div class="orders-filter-right">
        ☰
      </div>

    </div>

    <!-- TABLE -->
    <table class="orders-table">

      <thead>
        <tr>
          <th width="40">
            <input type="checkbox">
          </th>

          <th>Order</th>
          <th>Date</th>
          <th>Customer</th>
          <th>Payment status</th>
          <th>Fulfillment</th>
          <th>Total</th>
        </tr>
      </thead>

      <tbody>

        <% @orders.each do |order| %>

          <tr onclick="window.location='<%= order_path(order.store_id, order) %>'">

            <td>
              <input type="checkbox">
            </td>

            <td class="order-number">
              #<%= order.id %>
            </td>

            <td>
              <%= order.created_at.strftime("%b %d at %I:%M %p") %>
            </td>

            <td>
              <%= order.customer&.full_name || "Guest" %>
            </td>

            <td>
              <span class="status-badge paid">
                Paid
              </span>
            </td>

            <td>
              <span class="status-badge unfulfilled">
                Unfulfilled
              </span>
            </td>

            <td class="order-total">
              Rs <%= order.total_price %>
            </td>

          </tr>

        <% end %>

      </tbody>

    </table>

  </div>

</div>

<style>
.shopify-orders-page {
  padding: 24px;
  background: #f6f6f7;
  min-height: 100vh;
}

/* TOPBAR */

.orders-topbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20px;
}

.orders-title-section h1 {
  font-size: 30px;
  font-weight: 650;
  color: #111827;
}

.create-order-btn {
  background: #111827;
  color: white;
  border: none;
  padding: 11px 18px;
  border-radius: 14px;
  font-size: 14px;
  font-weight: 600;
  cursor: pointer;
}

/* CARD */

.orders-card {
  background: white;
  border-radius: 18px;
  overflow: hidden;
  border: 1px solid #e5e7eb;
}

/* FILTER BAR */

.orders-filter-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18px 20px;
  border-bottom: 1px solid #e5e7eb;
}

.orders-filter-left {
  display: flex;
  align-items: center;
  gap: 14px;
}

.filter-dropdown {
  font-size: 16px;
  cursor: pointer;
  color: #111827;
}

.orders-search {
  background: #f3f4f6;
  border-radius: 12px;
  padding: 10px 16px;
  display: flex;
  align-items: center;
  width: 340px;
}

.orders-search input {
  border: none;
  background: transparent;
  outline: none;
  width: 100%;
  margin-left: 10px;
  font-size: 15px;
}

/* TABLE */

.orders-table {
  width: 100%;
  border-collapse: collapse;
}

.orders-table thead {
  background: #fafafa;
}

.orders-table th {
  text-align: left;
  font-size: 14px;
  font-weight: 600;
  color: #6b7280;
  padding: 18px 20px;
  border-bottom: 1px solid #e5e7eb;
}

.orders-table td {
  padding: 18px 20px;
  border-bottom: 1px solid #f1f1f1;
  font-size: 14px;
  color: #111827;
}

.orders-table tbody tr {
  cursor: pointer;
  transition: background 0.15s;
}

.orders-table tbody tr:hover {
  background: #fafafa;
}

.order-number {
  font-weight: 600;
}

.order-total {
  font-weight: 600;
}

/* BADGES */

.status-badge {
  padding: 6px 12px;
  border-radius: 999px;
  font-size: 13px;
  font-weight: 600;
}

.status-badge.paid {
  background: #dcfce7;
  color: #166534;
}

.status-badge.unfulfilled {
  background: #f3f4f6;
  color: #374151;
}
</style>