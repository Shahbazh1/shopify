<%# COLLECTION HEADER %>
<div style="background: #1a1a1a; color: white; padding: 48px 32px; text-align: center;">
  <div style="font-size: 12px; font-weight: 600; text-transform: uppercase; 
              letter-spacing: 1px; opacity: 0.6; margin-bottom: 12px;">
    Collection
  </div>
  <h1 style="font-size: 36px; font-weight: 800; margin-bottom: 12px;">
    <%= @collection.title %>
  </h1>
  <% if @collection.description.present? %>
    <p style="font-size: 16px; opacity: 0.7; max-width: 500px; margin: 0 auto;">
      <%= @collection.description %>
    </p>
  <% end %>
  <div style="margin-top: 16px; font-size: 13px; opacity: 0.5;">
    <%= @products.count %> <%= "product".pluralize(@products.count) %>
  </div>
</div>

<%# BREADCRUMB %>
<div style="padding: 16px 32px; font-size: 13px; color: #6b7280; 
            border-bottom: 1px solid #e5e5e5;">
  <%= link_to "Home", storefront_root_path, 
        style: "color: #6b7280; text-decoration: none;" %> /
  <%= link_to "Collections", storefront_root_path, 
        style: "color: #6b7280; text-decoration: none;" %> /
  <span style="color: #1a1a1a;"><%= @collection.title %></span>
</div>

<%# PRODUCTS GRID %>
<% if @products.any? %>
  <div class="sf-product-grid">
    <% @products.each do |product| %>
      <%= link_to storefront_product_path(product.slug), class: "sf-product-card" do %>
        <div class="sf-product-img">
          <% if product.product_images.any? %>
            <img src="<%= product.product_images.first.image_url %>"
                 alt="<%= product.title %>"
                 style="width:100%; height:100%; object-fit:cover;">
          <% else %>
            <i class="fa-solid fa-image"></i>
          <% end %>
        </div>
        <div class="sf-product-info">
          <div class="sf-product-title"><%= product.title %></div>
          <div class="sf-product-price">
            <% if product.product_variants.any? %>
              From <%= number_to_currency(product.product_variants.minimum(:price)) %>
            <% else %>
              <%= number_to_currency(product.price) %>
            <% end %>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>
<% else %>
  <div style="text-align:center; padding: 80px 32px; color: #6b7280;">
    <i class="fa-solid fa-box-open" style="font-size:48px; margin-bottom:16px; display:block;"></i>
    <p>No products in this collection yet.</p>
    <%= link_to "Browse All Products", storefront_products_path, 
          class: "sf-btn sf-btn-dark", style: "margin-top: 20px; display: inline-block;" %>
  </div>
<% end %>