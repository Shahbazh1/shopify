<%# app/views/storefront/pages/contact.html.erb %>
<div class="sf-page">
  <h1>Contact Us</h1>
  <p style="color:#6b7280; margin-bottom:32px; font-size:15px;">
    Have a question? We'd love to hear from you.
  </p>

  <div style="display:flex; flex-direction:column; gap:16px; max-width:480px;">
    <input type="text"  placeholder="Your name"    style="padding:12px; border:1px solid #e5e5e5; border-radius:8px; font-size:14px;">
    <input type="email" placeholder="Your email"   style="padding:12px; border:1px solid #e5e5e5; border-radius:8px; font-size:14px;">
    <textarea placeholder="Your message" rows="5"  style="padding:12px; border:1px solid #e5e5e5; border-radius:8px; font-size:14px; resize:vertical;"></textarea>
    <button class="sf-add-to-cart">Send Message</button>
  </div>
</div>