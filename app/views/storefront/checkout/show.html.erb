<div style="max-width: 960px; margin: 48px auto; padding: 0 32px; 
            display: grid; grid-template-columns: 1fr 380px; gap: 48px;">

  <%# LEFT — FORM %>
  <div>
    <h1 style="font-size: 24px; font-weight: 700; margin-bottom: 28px;">Checkout</h1>

    <%= form_with url: storefront_checkout_stripe_path,
              method: :post,
              data: { turbo: false } do |f| %>

      <%# CONTACT INFO %>
      <div style="margin-bottom: 28px;">
        <h2 style="font-size: 15px; font-weight: 700; margin-bottom: 16px; 
                   text-transform: uppercase; letter-spacing: 0.5px; color: #6b7280;">
          Contact Information
        </h2>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
          <div>
            <label style="font-size: 13px; font-weight: 500; display: block; margin-bottom: 4px;">
              First Name
            </label>
            <%= f.text_field :first_name,
                  name: "checkout[first_name]",
                  placeholder: "John",
                  required: true,
                  style: "width:100%; padding:10px 12px; border:1px solid #e5e5e5; 
                          border-radius:8px; font-size:14px; outline:none;" %>
          </div>
          <div>
            <label style="font-size: 13px; font-weight: 500; display: block; margin-bottom: 4px;">
              Last Name
            </label>
            <%= f.text_field :last_name,
                  name: "checkout[last_name]",
                  placeholder: "Doe",
                  required: true,
                  style: "width:100%; padding:10px 12px; border:1px solid #e5e5e5; 
                          border-radius:8px; font-size:14px; outline:none;" %>
          </div>
        </div>

        <div style="margin-top: 12px;">
          <label style="font-size: 13px; font-weight: 500; display: block; margin-bottom: 4px;">
            Email
          </label>
          <%= f.email_field :email,
                name: "checkout[email]",
                placeholder: "john@example.com",
                required: true,
                style: "width:100%; padding:10px 12px; border:1px solid #e5e5e5; 
                        border-radius:8px; font-size:14px; outline:none;" %>
        </div>

        <div style="margin-top: 12px;">
          <label style="font-size: 13px; font-weight: 500; display: block; margin-bottom: 4px;">
            Phone
          </label>
          <%= f.phone_field :phone,
                name: "checkout[phone]",
                placeholder: "+92 300 0000000",
                style: "width:100%; padding:10px 12px; border:1px solid #e5e5e5; 
                        border-radius:8px; font-size:14px; outline:none;" %>
        </div>
      </div>

      <%# SHIPPING ADDRESS %>
      <div style="margin-bottom: 28px;">
        <h2 style="font-size: 15px; font-weight: 700; margin-bottom: 16px;
                   text-transform: uppercase; letter-spacing: 0.5px; color: #6b7280;">
          Shipping Address
        </h2>

        <div style="margin-bottom: 12px;">
          <label style="font-size: 13px; font-weight: 500; display: block; margin-bottom: 4px;">
            Address
          </label>
          <%= f.text_field :address,
                name: "checkout[address]",
                placeholder: "123 Main Street",
                required: true,
                style: "width:100%; padding:10px 12px; border:1px solid #e5e5e5; 
                        border-radius:8px; font-size:14px; outline:none;" %>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
          <div>
            <label style="font-size: 13px; font-weight: 500; display: block; margin-bottom: 4px;">
              City
            </label>
            <%= f.text_field :city,
                  name: "checkout[city]",
                  placeholder: "Lahore",
                  required: true,
                  style: "width:100%; padding:10px 12px; border:1px solid #e5e5e5; 
                          border-radius:8px; font-size:14px; outline:none;" %>
          </div>
          <div>
            <label style="font-size: 13px; font-weight: 500; display: block; margin-bottom: 4px;">
              Postal Code
            </label>
            <%= f.text_field :postal_code,
                  name: "checkout[postal_code]",
                  placeholder: "54000",
                  style: "width:100%; padding:10px 12px; border:1px solid #e5e5e5; 
                          border-radius:8px; font-size:14px; outline:none;" %>
          </div>
        </div>

        <div style="margin-top: 12px;">
          <label style="font-size: 13px; font-weight: 500; display: block; margin-bottom: 4px;">
            Country
          </label>
          <%= f.text_field :country,
                name: "checkout[country]",
                placeholder: "Pakistan",
                value: "Pakistan",
                style: "width:100%; padding:10px 12px; border:1px solid #e5e5e5; 
                        border-radius:8px; font-size:14px; outline:none;" %>
        </div>
      </div>

      <%# DISCOUNT CODE %>
      <div style="margin-bottom: 28px;">
        <h2 style="font-size: 15px; font-weight: 700; margin-bottom: 16px; text-transform: uppercase; letter-spacing: 0.5px; color: #6b7280;">
          Discount
        </h2>

        <div>
          <label style="font-size: 13px; font-weight: 500; display: block; margin-bottom: 4px;">
            Discount Code (optional)
          </label>

          <%= f.text_field :discount_code,
                name: "checkout[discount_code]",
                placeholder: "Enter discount code",
                style: "width:100%; padding:10px 12px; border:1px solid #e5e5e5;
                        border-radius:8px; font-size:14px; outline:none;" %>
        </div>
      </div>


      <%= f.submit "Pay with Stripe →",
            style: "width:100%; padding:14px; background:#1a1a1a; color:white;
                    border:none; border-radius:8px; font-size:15px; font-weight:600;
                    cursor:pointer;" %>

    <% end %>
  </div>

  <%# RIGHT — ORDER SUMMARY %>
  <div style="border-top: 1px solid #e5e5e5; padding-top: 16px; margin-top: 8px;">
  <div style="display: flex; justify-content: space-between; 
              font-size: 14px; margin-bottom: 8px;">
    <span style="color: #6b7280;">Subtotal</span>
    <span><%= number_to_currency(@subtotal) %></span>
  </div>

  <% if @order_discount > 0 %>
    <div style="display: flex; justify-content: space-between; 
                font-size: 14px; margin-bottom: 8px; color: #16a34a;">
      <span>Discount</span>
      <span>− <%= number_to_currency(@order_discount) %></span>
    </div>
  <% end %>

  <div style="display: flex; justify-content: space-between; 
              font-size: 14px; margin-bottom: 16px;">
    <span style="color: #6b7280;">Shipping</span>
    <span><%= @shipping_price == 0 ? "Free" : number_to_currency(@shipping_price) %></span>
  </div>

  <div style="display: flex; justify-content: space-between; 
              font-size: 16px; font-weight: 700; border-top: 1px solid #e5e5e5; padding-top: 12px;">
    <span>Total</span>
    <span><%= number_to_currency(@total) %></span>
  </div>
</div>

</div>