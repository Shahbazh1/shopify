<div style="max-width: 960px; margin: 48px auto; padding: 0 32px; 
            display: grid; grid-template-columns: 1fr 380px; gap: 48px;">

  <%# LEFT — FORM %>
  <div>
    <h1 style="font-size: 24px; font-weight: 700; margin-bottom: 28px;">Checkout</h1>

    <%= form_with url: storefront_checkout_create_path, method: :post do |f| %>

      <%# CONTACT INFO %>
      <div style="margin-bottom: 28px;">
        <h2 style="font-size: 15px; font-weight: 700; margin-bottom: 16px; 
                   text-transform: uppercase; letter-spacing: 0.5px; color: #6b7280;">
          Contact Information
        </h2>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
          <div>
            <label style="font-size: 13px; font-weight: 500; display: block; margin-bottom: 4px;">
              First Name
            </label>
            <%= f.text_field :first_name,
                  name: "checkout[first_name]",
                  placeholder: "John",
                  required: true,
                  style: "width:100%; padding:10px 12px; border:1px solid #e5e5e5; 
                          border-radius:8px; font-size:14px; outline:none;" %>
          </div>
          <div>
            <label style="font-size: 13px; font-weight: 500; display: block; margin-bottom: 4px;">
              Last Name
            </label>
            <%= f.text_field :last_name,
                  name: "checkout[last_name]",
                  placeholder: "Doe",
                  required: true,
                  style: "width:100%; padding:10px 12px; border:1px solid #e5e5e5; 
                          border-radius:8px; font-size:14px; outline:none;" %>
          </div>
        </div>

        <div style="margin-top: 12px;">
          <label style="font-size: 13px; font-weight: 500; display: block; margin-bottom: 4px;">
            Email
          </label>
          <%= f.email_field :email,
                name: "checkout[email]",
                placeholder: "john@example.com",
                required: true,
                style: "width:100%; padding:10px 12px; border:1px solid #e5e5e5; 
                        border-radius:8px; font-size:14px; outline:none;" %>
        </div>

        <div style="margin-top: 12px;">
          <label style="font-size: 13px; font-weight: 500; display: block; margin-bottom: 4px;">
            Phone
          </label>
          <%= f.phone_field :phone,
                name: "checkout[phone]",
                placeholder: "+92 300 0000000",
                style: "width:100%; padding:10px 12px; border:1px solid #e5e5e5; 
                        border-radius:8px; font-size:14px; outline:none;" %>
        </div>
      </div>

      <%# SHIPPING ADDRESS %>
      <div style="margin-bottom: 28px;">
        <h2 style="font-size: 15px; font-weight: 700; margin-bottom: 16px;
                   text-transform: uppercase; letter-spacing: 0.5px; color: #6b7280;">
          Shipping Address
        </h2>

        <div style="margin-bottom: 12px;">
          <label style="font-size: 13px; font-weight: 500; display: block; margin-bottom: 4px;">
            Address
          </label>
          <%= f.text_field :address,
                name: "checkout[address]",
                placeholder: "123 Main Street",
                required: true,
                style: "width:100%; padding:10px 12px; border:1px solid #e5e5e5; 
                        border-radius:8px; font-size:14px; outline:none;" %>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
          <div>
            <label style="font-size: 13px; font-weight: 500; display: block; margin-bottom: 4px;">
              City
            </label>
            <%= f.text_field :city,
                  name: "checkout[city]",
                  placeholder: "Lahore",
                  required: true,
                  style: "width:100%; padding:10px 12px; border:1px solid #e5e5e5; 
                          border-radius:8px; font-size:14px; outline:none;" %>
          </div>
          <div>
            <label style="font-size: 13px; font-weight: 500; display: block; margin-bottom: 4px;">
              Postal Code
            </label>
            <%= f.text_field :postal_code,
                  name: "checkout[postal_code]",
                  placeholder: "54000",
                  style: "width:100%; padding:10px 12px; border:1px solid #e5e5e5; 
                          border-radius:8px; font-size:14px; outline:none;" %>
          </div>
        </div>

        <div style="margin-top: 12px;">
          <label style="font-size: 13px; font-weight: 500; display: block; margin-bottom: 4px;">
            Country
          </label>
          <%= f.text_field :country,
                name: "checkout[country]",
                placeholder: "Pakistan",
                value: "Pakistan",
                style: "width:100%; padding:10px 12px; border:1px solid #e5e5e5; 
                        border-radius:8px; font-size:14px; outline:none;" %>
        </div>
      </div>

      <%# SHIPPING METHOD %>
      <div style="margin-bottom: 28px;">
        <h2 style="font-size: 15px; font-weight: 700; margin-bottom: 16px;
                   text-transform: uppercase; letter-spacing: 0.5px; color: #6b7280;">
          Shipping Method
        </h2>

        <% @shipping_methods.each do |method| %>
          <label style="display: flex; align-items: center; justify-content: space-between;
                        padding: 14px 16px; border: 1px solid #e5e5e5; border-radius: 8px;
                        margin-bottom: 8px; cursor: pointer; transition: border-color 0.15s;">
            <div style="display: flex; align-items: center; gap: 12px;">
              <input type="radio" 
                     name="checkout[shipping_method_id]" 
                     value="<%= method.id %>"
                     <%= "checked" if method == @shipping_methods.first %>>
              <div>
                <div style="font-size: 14px; font-weight: 600;"><%= method.name %></div>
              </div>
            </div>
            <span style="font-size: 14px; font-weight: 600;">
              <%= method.price.zero? ? "Free" : number_to_currency(method.price) %>
            </span>
          </label>
        <% end %>
      </div>

      <%= f.submit "Place Order →",
            style: "width:100%; padding:14px; background:#1a1a1a; color:white;
                    border:none; border-radius:8px; font-size:15px; font-weight:600;
                    cursor:pointer;" %>

    <% end %>
  </div>

  <%# RIGHT — ORDER SUMMARY %>
  <div>
    <div style="background: #f9fafb; border-radius: 12px; padding: 24px; 
                position: sticky; top: 80px;">
      <h2 style="font-size: 16px; font-weight: 700; margin-bottom: 20px;">
        Order Summary
      </h2>

      <% @cart_items.each do |item| %>
        <div style="display: flex; justify-content: space-between; 
                    align-items: center; margin-bottom: 16px;">
          <div>
            <div style="font-size: 14px; font-weight: 600;">
              <%= item.product.title %>
            </div>
            <div style="font-size: 12px; color: #6b7280;">
              <%= [item.product_variant.size, item.product_variant.color].compact.join(" / ") %>
              × <%= item.quantity %>
            </div>
          </div>
          <span style="font-size: 14px; font-weight: 500;">
            <%= number_to_currency(item.product_variant.price * item.quantity) %>
          </span>
        </div>
      <% end %>

      <div style="border-top: 1px solid #e5e5e5; padding-top: 16px; margin-top: 8px;">
        <div style="display: flex; justify-content: space-between; 
                    font-size: 14px; margin-bottom: 8px;">
          <span style="color: #6b7280;">Subtotal</span>
          <span><%= number_to_currency(@subtotal) %></span>
        </div>
        <div style="display: flex; justify-content: space-between; 
                    font-size: 14px; margin-bottom: 16px;">
          <span style="color: #6b7280;">Shipping</span>
          <span>Calculated above</span>
        </div>
        <div style="display: flex; justify-content: space-between; 
                    font-size: 16px; font-weight: 700;">
          <span>Total</span>
          <span><%= number_to_currency(@subtotal) %>+</span>
        </div>
      </div>
    </div>
  </div>

</div>