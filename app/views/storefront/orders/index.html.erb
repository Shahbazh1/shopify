<div style="max-width: 700px; margin: 40px auto;">
  <h2>My Orders</h2>

  <% if @orders.empty? %>
    <p>You have no orders yet.</p>
  <% else %>
    <% @orders.each do |order| %>
      <div style="border: 1px solid #e5e7eb; border-radius: 8px; padding: 16px; margin-bottom: 16px;">
        <div style="display: flex; justify-content: space-between;">
          <strong>Order #<%= order.id %></strong>
          <span><%= order.created_at.strftime("%b %d, %Y") %></span>
        </div>
        <div>Total: <%= number_to_currency(order.total_price) %></div>
        <div>Status: <%= order.fulfillment_status.capitalize %></div>
        <%= link_to "Track Order →", storefront_order_path(order), style: "color: #10b981;" %>
      </div>
    <% end %>
  <% end %>
</div>