<div style="max-width: 600px; margin: 64px auto; padding: 0 32px; text-align: center;">

  <%# SUCCESS ICON %>
  <div style="width: 64px; height: 64px; background: #d1fae5; border-radius: 50%;
              display: flex; align-items: center; justify-content: center;
              margin: 0 auto 24px; font-size: 28px;">
    ✓
  </div>

  <h1 style="font-size: 28px; font-weight: 800; margin-bottom: 8px;">
    Order Confirmed!
  </h1>
  <p style="color: #6b7280; margin-bottom: 8px;">
    Order #<%= @order.id %>
  </p>
  <p style="color: #6b7280; margin-bottom: 40px;">
    Thank you! We've received your order and will process it shortly.
  </p>

  <%# ORDER DETAILS %>
  <div style="background: #f9fafb; border-radius: 12px; padding: 24px; 
              text-align: left; margin-bottom: 32px;">
    <h2 style="font-size: 15px; font-weight: 700; margin-bottom: 16px;">
      Order Details
    </h2>

    <% @order_items.each do |item| %>
      <div style="display: flex; justify-content: space-between;
                  padding: 10px 0; border-bottom: 1px solid #e5e5e5;
                  font-size: 14px;">
        <div>
          <div style="font-weight: 600;"><%= item.product.title %></div>
          <div style="color: #6b7280; font-size: 12px;">
            <%= [item.product_variant.size, item.product_variant.color].compact.join(" / ") %>
            × <%= item.quantity %>
          </div>
        </div>
        <span><%= number_to_currency(item.price * item.quantity) %></span>
      </div>
    <% end %>

    <div style="display: flex; justify-content: space-between; 
                padding-top: 14px; font-size: 14px; margin-bottom: 6px;">
      <span style="color: #6b7280;">Subtotal</span>
      <span><%= number_to_currency(@order.subtotal) %></span>
    </div>
    <div style="display: flex; justify-content: space-between; font-size: 14px;">
      <span style="color: #6b7280;">Shipping (<%= @order.shipping_method.name %>)</span>
      <span><%= number_to_currency(@order.shipping_price) %></span>
    </div>
    <div style="display: flex; justify-content: space-between; 
                font-size: 16px; font-weight: 700; padding-top: 14px; 
                border-top: 1px solid #e5e5e5; margin-top: 10px;">
      <span>Total</span>
      <span><%= number_to_currency(@order.total_price) %></span>
    </div>
  </div>

  <%# STATUS BADGE %>
  <div style="margin-bottom: 32px;">
    <span style="background: #fef3c7; color: #92400e; padding: 6px 16px;
                 border-radius: 20px; font-size: 13px; font-weight: 600;">
      Status: <%= @order.status.capitalize %>
    </span>
  </div>

  <%= link_to "Continue Shopping", storefront_products_path,
        style: "display: inline-block; padding: 12px 28px; background: #1a1a1a;
                color: white; border-radius: 8px; font-weight: 600; 
                font-size: 14px; text-decoration: none;" %>
</div>