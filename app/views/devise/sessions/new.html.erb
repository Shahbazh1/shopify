<style>
  /* Reset & Base Styles */
  * {
    box-sizing: border-box;
    -webkit-font-smoothing: antialiased;
  }

  body {
    margin: 0;
    padding: 0;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    background: radial-gradient(circle at top, #0b1411 0%, #070a0a 100%);
    color: white;
    min-height: 100vh;
  }

  /* Page wrapper */
  .login-container {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(10px, 2vw, 18px);
    padding: 20px;
  }

  /* Shopify logo */
  .logo {
    margin-bottom: clamp(20px, 4vw, 40px);
    display: flex;
    justify-content: center;
    transition: transform 0.3s ease;
  }

  .logo img {
    width: 60px;
    height: auto;
  }

  /* Card */
  .card {
    width: 100%;
    max-width: 400px;
    background: #ffffff;
    color: #111;
    border-radius: 16px;
    padding: 32px;
    box-shadow: 0 20px 40px rgba(0,0,0,0.4);
  }

  /* Heading */
  .card h1 {
    font-size: 24px;
    margin: 0;
    font-weight: 700;
    letter-spacing: -0.5px;
  }

  .card p {
    margin: 8px 0 24px;
    font-size: 15px;
    color: #555;
  }

  /* Form Elements */
  .form-group {
    margin-bottom: 16px;
    text-align: left;
  }

  .form-label {
    display: block;
    font-size: 13px;
    font-weight: 500;
    margin-bottom: 6px;
    color: #333;
  }

  input[type="email"] {
    width: 100%;
    padding: 12px 14px;
    border: 1px solid #d1d1d1;
    border-radius: 8px;
    font-size: 16px;
    outline: none;
    transition: border-color 0.2s;
  }

  input[type="email"]:focus {
    border-color: #008060;
    box-shadow: 0 0 0 1px #008060;
  }

  /* Buttons */
  .btn-primary {
    width: 100%;
    padding: 13px;
    background: #1a1a1a;
    color: #fff;
    border: none;
    border-radius: 8px;
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s;
  }

  .btn-primary:hover {
    background: #000;
  }

  /* Divider */
  .divider {
    display: flex;
    align-items: center;
    margin: 20px 0;
    font-size: 13px;
    color: #6d7175;
  }

  .divider::before,
  .divider::after {
    content: "";
    flex: 1;
    height: 1px;
    background: #e1e3e5;
  }

  .divider span {
    padding: 0 12px;
  }

  /* Passkey button */
  .btn-secondary {
    width: 100%;
    padding: 11px;
    border-radius: 8px;
    border: 1px solid #d1d1d1;
    background: #fff;
    font-size: 14px;
    font-weight: 500;
    margin-bottom: 12px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }

  .btn-secondary:hover {
    background: #f6f6f7;
  }

  /* Social buttons */
  .social-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
  }

  .btn-social {
    padding: 10px;
    border-radius: 8px;
    border: 1px solid #d1d1d1;
    background: #fff;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s;
  }

  .btn-social:hover {
    background: #f6f6f7;
  }

  .btn-social img {
    width: 20px;
    height: 20px;
  }

  /* Footer */
  .footer-links {
    text-align: center;
    margin-top: 24px;
    font-size: 14px;
  }

  .footer-links a {
    color: #005bd3;
    text-decoration: none;
    font-weight: 500;
  }

  .legal-footer {
    margin-top: 30px;
    text-align: center;
    max-width: 300px;
  }

  .help-link { font-size: 13px; color: #b5b5b5; text-decoration: none; }
  .terms-text { font-size: 11px; color: #888; margin-top: 8px; line-height: 1.4; }

  /* Mobile */
  @media (max-width: 480px) {
    .card {
      padding: 24px 20px;
      border-radius: 12px;
    }

    .logo {
      margin-bottom: 18px;
    }

    .logo img {
      width: 40px;
    }

    .card h1 {
      font-size: 20px;
    }

    input[type="email"], .btn-primary {
      font-size: 14px;
    }
  }

  /* Small height devices */
  @media (max-height: 600px) {
    .login-container {
      justify-content: flex-start;
      padding-top: 20px;
    }
  }
</style>

<div class="login-container">

  <!-- Logo -->
  <div class="logo">
    <%= image_tag(
      "https://shopify-assets.shopifycdn.com/shopifycloud/identity/assets/logo/shopify_icon-3ec3196fc21ccd335e623091378b9da827ad0032b2e987dcd2fe6cfc32cd3c5c.svg",
      alt: "Shopify"
    ) %>
  </div>

  <!-- Card -->
  <div class="card">
    <h1>Log in</h1>
    <p>Continue to Shopify</p>

    <%= form_with url: session_path(resource_name), local: true do |f| %>

      <div class="form-group">
        <%= f.label :email, "Email", class: "form-label" %>
        <%= f.email_field :email,
              placeholder: "Enter email",
              autofocus: true %>
      </div>

      <%= f.submit "Continue with email", class: "btn-primary" %>

    <% end %>

    <div class="divider">
      <span>or</span>
    </div>

    <!-- Passkey Button -->
    <%= button_tag type: "button", class: "btn-secondary" do %>
      <span>👤</span> Sign in with passkey
    <% end %>

    <!-- Social Login -->
    <div class="social-grid">

      <!-- Apple -->
      <%= button_to "#", class: "btn-social" do %>
        <%= image_tag "https://shopify-assets.shopifycdn.com/shopifycloud/identity/assets/external/apple-7ddeaf08016f8cb19bed914ba94ecdca365c63c275340ec1c4d037f58e68bc04.svg",
                      alt: "Apple" %>
      <% end %>

      <!-- Facebook -->
      <%= button_to user_facebook_omniauth_authorize_path,data: { turbo: false },
              method: :post,
              class: "btn-social" do %>
  <%= image_tag "https://www.svgrepo.com/show/452196/facebook-1.svg", alt: "Facebook" %>
<% end %>

      <!-- Google -->
      <%= button_to user_google_oauth2_omniauth_authorize_path,data: { turbo: false },
              method: :post,
              class: "btn-social" do %>
  <%= image_tag "https://www.svgrepo.com/show/355037/google.svg", alt: "Google" %>
<% end %>

    </div>

    <div class="footer-links">
      New to Shopify?
      <%= link_to "Get started →", new_registration_path(resource_name) %>
    </div>
  </div>

  <!-- Footer -->
  <div class="legal-footer">
    <%= link_to "Need Help?", "#", class: "help-link" %>

    <p class="terms-text">
      By continuing, you agree to the
      <%= link_to "Terms of Service", "#", style: "color:inherit" %>
      and
      <%= link_to "Privacy Policy", "#", style: "color:inherit" %>.
    </p>
  </div>

</div>