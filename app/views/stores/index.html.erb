<h1>Your Stores</h1>

<%= link_to "➕ Add New Store", new_store_path %>

<table>
  <thead>
    <tr>
      <th>Name</th>
      <th>Slug</th>
      <th>Domain</th>
      <th>Action</th>
    </tr>
  </thead>

  <tbody>
    <% @stores.each do |store| %>
    <tr onclick="window.location='<%= home_store_path(store) %>'" style="cursor: pointer;">
        <td><%= store.name %></td>
        <td><%= store.slug %></td>
        <td><%= store.domain %></td>
        <td>
          <%= link_to "Edit", edit_store_path(store) %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>